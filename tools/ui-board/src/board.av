//! The task board — the UI library's showcase. The screen is made of
//! COMPOSITIONS: a component whose body is what it is made of. `filters`
//! is three `tab`s and a button; `new_task` is a field and a button, and
//! the draft a user is typing is THAT instance's own `state`; the rest
//! of the program's state is the module's.
//!
//! Each handler is written where its control is: `on press { … }` is a
//! closure over what its composition could see, so row 3's Remove names
//! row 3's task. The task rows are ONE keyed list (`list visible() by
//! it.id`), so the row identity is the task id and an insert or a
//! removal touches no other row.
//!
//! The board names no target. A page mounts it (`web/`) and so does a
//! terminal (`term/`).
use @std.json.codec.{json}
use @std.json.typed.{array_of, as_bool, as_int, bool_text, elements, int_text}
use @std.time.{ms}
use @std.ui.app.{Async, Fetch, fetch, fetched, later}
use @std.ui.shipped.{ship}
use @std.http_message.message.{Body, Reply, Request}
use @std.json.{Json, field as member, parse, to_text}
use @std.text.{parse_int}
use @std.ui.components.{
    button,
    card,
    checkbox,
    column,
    dialog,
    divider,
    field,
    heading,
    item,
    list,
    progress,
    row,
    surface,
    text,
}
use @std.ui.style.layout.{Layout, around}
use @std.ui.style.style.{Style}
use @std.ui.style.theme.{Theme, dark_theme, default_theme}

/// Which tasks the board shows.
@json
enum Show { All, Active, Done }

/// One task. `id` is the item key; `done` is its state.
@json
type Task = { id: string, title: string, done: bool }

/// The board's heading.
fn title() -> string { "Tasks" }

// ── state ───────────────────────────────────────────────────────

state filter: Show = .All
state dark: bool = false
state newest_first: bool = false
state dialog_open: bool = false
state reminded: bool = false
state synced: Fetch<int> = fetch()
state started: Fetch<int> = fetch()
state seq: int = 5
state pending: string = ""
state tasks: List<Task> = [
    Task { id: "t1", title: "Draft the spec", done: true },
    Task { id: "t2", title: "Wire the event channel", done: false },
    Task { id: "t3", title: "Land the wasm board", done: false },
    Task { id: "t4", title: "Write the tour", done: true },
]

// ── the state a page carries ────────────────────────────────────

/// Name the states a server's page carries to the module: what the view
/// reads and a request decides. A state not named here is never shipped.
export fn ship_state() {
    ship("filter", Show.json_shape(), () -> filter.json_text(), (j: string) -> filter_written(j))
    ship("dark", "bool", () -> bool_text(dark), (j: string) -> dark_written(j))
    ship("seq", "int", () -> int_text(seq), (j: string) -> seq_written(j))
    ship(
        "tasks",
        "[${Task.json_shape()}]",
        () -> array_of([t.json_text() for t in tasks]),
        (j: string) -> tasks_written(j),
    )
}

/// What a request for the done tasks in the dark decides, as a server's
/// handler would before it draws the page.
export fn requested() {
    filter = .Done
    dark = true
}

fn filter_written(j: string) -> bool {
    match Show.from_json_text(j) {
        .Ok(shown) -> {
            filter = shown
            true
        },
        .Err(_) -> false,
    }
}

fn dark_written(j: string) -> bool {
    match as_bool(j) {
        .Ok(on) -> {
            dark = on
            true
        },
        .Err(_) -> false,
    }
}

fn seq_written(j: string) -> bool {
    match as_int(j) {
        .Ok(n) -> {
            seq = n
            true
        },
        .Err(_) -> false,
    }
}

fn tasks_written(j: string) -> bool {
    match todos_of(j) {
        .Ok(read) -> {
            tasks = read
            true
        },
        .Err(_) -> false,
    }
}

fn todos_of(j: string) -> Result<List<Task>, string> {
    [Task.from_json_text(entry)? for entry in elements(j)?]
}

/// The counts are DERIVED from the list, never stored beside it.
fn done_count() -> int { [t for t in tasks if t.done].length }

fn open_count() -> int { [t for t in tasks if !t.done].length }

fn admits(t: Task) -> bool {
    match filter { .All -> true, .Active -> !t.done, .Done -> t.done }
}

export fn theme() -> Theme { if dark { dark_theme } else { default_theme } }

/// `title` becomes the next task — none, when it says nothing.
fn add(title: string) {
    if title == "" { return }
    tasks = tasks.concat([Task { id: "t${seq}", title: title, done: false }])
    seq = seq + 1
}

/// This task with its state as given when it is the named one, unchanged
/// otherwise.
fn marked(t: Task, id: string, done: bool) -> Task {
    if t.id == id { t with { done: done } } else { t }
}

// ── view: state in, tree out ────────────────────────────────────

fn theme_label() -> string { if dark { "Light mode" } else { "Dark mode" } }

fn tab_style(on: bool) -> Style {
    if on { sunk_style() } else { Style { radius: .S } }
}

fn title_style(done: bool) -> Style {
    if done { Style { color: .Muted } } else { Style { color: .Text } }
}

fn sunk_style() -> Style { Style { fill: .SurfaceSunk, radius: .S } }

/// A run of controls on one line.
fn inline_layout() -> Layout { Layout { gap: .S, align: .Center } }

fn spread_layout() -> Layout { Layout { gap: .M, align: .Center, distribute: .SpaceBetween } }

/// One filter: pressed, it is the filter in force.
component tab(label: string) {
    shows: Show
    button self.label {
        on press { filter = self.shows }
        style: tab_style(filter == self.shows)
    }
}

component header {
    row {
        layout: spread_layout()
        column {
            layout: Layout { gap: .Xs }
            heading title() { rank: 1 }
            text "Every task is a value; the screen is a function of state." { style: Style { color: .Muted } }
        }
        button theme_label() {
            on press { dark = !dark }
            style: sunk_style()
        }
    }
}

component filters {
    row {
        layout: inline_layout()
        tab "All" { shows: .All }
        tab "Active" { shows: .Active }
        tab "Done" { shows: .Done }
        button "Clear done" {
            on press { tasks = [t for t in tasks if !t.done] }
            disabled: done_count() == 0
            style: sunk_style()
        }
        button "Newest first" {
            on press { newest_first = !newest_first }
            style: tab_style(newest_first)
        }
    }
}

/// The field a task is typed into. THE DRAFT IS THIS INSTANCE'S: nothing
/// else on the board reads what is being typed, so nothing else holds it.
component new_task {
    state draft: string = ""
    row {
        layout: inline_layout()
        field "New task" {
            value: self.draft
            placeholder: "Type a task…"
            on input { body -> self.draft = body }
        }
        button "Add" {
            on press {
                add(self.draft)
                self.draft = ""
            }
            style: sunk_style()
        }
    }
}

/// One task's row. Its key is the task's id, so its node goes where the
/// task goes.
component task_row(task: Task) {
    item {
        checkbox self.task.title {
            checked: self.task.done
            on change { checked -> tasks = [marked(x, self.task.id, checked) for x in tasks] }
            style: title_style(self.task.done)
        }
        button "Remove" {
            on press { tasks = [x for x in tasks if x.id != self.task.id] }
            style: sunk_style()
        }
    }
}

/// The task rows: ONE list of keyed rows, so a reorder or an insert
/// keeps every node. An empty view is a word, never a stray row.
component task_rows {
    if visible().is_empty() {
        text "Nothing here yet." { style: Style { color: .Muted } }
    } else {
        list {
            for t in visible() { task_row t { key: t.id } }
        }
    }
}

/// The tasks the filter admits, in the order the board shows them. The
/// rows are keyed, so turning the order CARRIES each row: none is made.
fn visible() -> List<Task> {
    let admitted = [t for t in tasks if admits(t)]
    if newest_first { [admitted[admitted.length - 1 - j] for j, t in admitted] } else { admitted }
}

component board {
    card "Board" {
        style: Style { fill: .SurfaceRaised, radius: .M }
        layout: Layout { gap: .M, pad: around(.M) }
        progress "Done" {
            amount: done_count()
            max: tasks.length
        }
        filters {}
        new_task {}
        divider {}
        task_rows {}
    }
}

/// The reminder fires: the footer says so.
fn remind_now() -> bool {
    reminded = true
    true
}

/// Whether the server keeps the task: its `id` is then the server's own
/// numeric key, where a task made on this page wears `t<n>`.
fn held(t: Task) -> bool { parse_int(t.id) != null }

/// A task as the server writes it: `{"id":1,"title":"…","done":false}`.
fn todo_of(j: Json) -> Task? {
    let key? = j.get("id")?.int() else { return null }
    let title? = j.get("title")?.text() else { return null }
    Task { id: "${key}", title: title, done: j.get("done")?.truth() ?? false }
}

/// The reply's body as JSON, or why it is not.
fn document(r: Reply) -> Result<Json, string> {
    if r.status < 200 || r.status > 299 { return .Err("status ${r.status}") }
    let words? = r.body.text() else { return .Err("not text") }
    match parse(words) { .Ok(j) -> .Ok(j), .Err(e) -> .Err(e.describe().message) }
}

/// The server's tasks replace the board's when it holds any; answers how
/// many it holds.
fn loaded(r: Reply) -> Result<int, string> {
    let doc = document(r)?
    let rows = [t! for t in [todo_of(j) for j in doc.items()] if t != null]
    if !rows.is_empty() { tasks = rows }
    .Ok(rows.length)
}

/// The task the server kept stands where the pending one did; answers how
/// many tasks the server now holds.
fn kept(r: Reply) -> Result<int, string> {
    let doc = document(r)?
    let made? = todo_of(doc) else { return .Err("the server's task is unreadable") }
    tasks = [if t.id == pending { made } else { t } for t in tasks]
    .Ok([t for t in tasks if held(t)].length)
}

/// The tasks are asked for at start: one request, whatever target sends it,
/// its progress kept apart from the footer's Sync words.
fn load() {
    let _ = fetched(started, Request.get("/tasks"), loaded)
}

/// Sync sends the first task the server does not hold; with none to send it
/// asks for the server's again.
fn sync() {
    let unsent? = tasks.find(!held(it)) else {
        let _ = fetched(synced, Request.get("/tasks"), loaded)
        return
    }
    pending = unsent.id
    let body = Json
        .Obj([member("title", Json.Str(unsent.title)), member("done", Json.Bool(unsent.done))])
    let _ = fetched(synced, Request.post("/tasks", Body.Json(to_text(body))), kept)
}

/// How the last sync stands, in words.
fn synced_words() -> string {
    match synced.state() {
        .Idle -> "",
        .Loading -> " · syncing",
        .Failed(why) -> " · sync failed: ${why}",
        .Ready(n) -> " · synced ${n}",
    }
}

/// A reminder is asked for: a timer, whatever the target keeps it with.
fn remind() {
    let _ = later(ms(100), remind_now)
}

component footer {
    row {
        layout: spread_layout()
        text "${open_count()} open · ${done_count()} done of ${tasks.length}${if reminded { " · reminder" } else { "" }}${synced_words()}" {
            style: Style { color: .Muted }
        }
        button "Sync" {
            on press { sync() }
            style: sunk_style()
        }
        button "Remind me" {
            on press { remind() }
            style: sunk_style()
        }
        button "About" {
            on press { dialog_open = true }
            style: sunk_style()
        }
    }
}

component about {
    dialog "About" {
        open: dialog_open
        on dismiss { dialog_open = false }
        heading "Task board" { rank: 2 }
        text "The board is made of compositions; each keeps what is its own."
        button "Close" {
            on press { dialog_open = false }
            style: sunk_style()
        }
    }
}

export fn view() -> surface {
    surface {
        style: Style { fill: .Surface, radius: .M }
        layout: Layout { gap: .M, pad: around(.L) }
        header {}
        board {}
        footer {}
        about {}
    }
}
