//! The task board — the UI library's showcase, as a wasm app. `view` is a
//! function of module `state`: tasks with done-state, three filters, a
//! derived count and progress, a dialog and a theme mode. `update` is ONE
//! exhaustive match over `Msg`, so a new message breaks the build here.
//!
//! Interaction is global AND per-item: a whole `Msg` addresses a control by
//! content-addressed site, and a per-item message carries its row's id as a
//! typed payload. The host echoes the payload the frame named back across
//! the ABI (`avra_event`'s tag/value seats), so a click on row 3's Remove
//! rebuilds `Msg.Remove("t3")`, never the first row's.
use @std.meta.{derive}
use @std.ui.components.{
    card,
    column,
    dialog,
    divider,
    field,
    heading,
    item,
    list,
    progress,
    row,
    surface,
    text,
}
use @std.ui.realize.dom.frame.{Live, event_at, live}
use @std.ui.realize.messages.{Messages}
use @std.ui.realize.payload.{Payload}
use @std.ui.realize.prim.{prim}
use @std.ui.realize.view.{View}
use @std.ui.style.box.{Box}
use @std.ui.style.layout.{Layout, around}
use @std.ui.style.style.{Style}
use @std.ui.style.theme.{Theme, dark_theme, default_theme}

extern fn avra_dom_frame(frame: Bytes)
extern fn avra_bytes_with_room(n: int) -> Bytes
extern fn avra_bytes_adopted(p: Bytes, n: int) -> Bytes

/// The screen's actions: a control with no payload carries its site alone,
/// and a per-item action names its row by id. A message's captures ride the
/// frame as a typed `Payload` and the host echoes them back, so `Toggle("t3")`
/// and `Toggle("t1")` stay distinct however the tree moved.
@derive(Messages)
enum Msg {
    ShowAll
    ShowActive
    ShowDone
    ClearDone
    ToggleTheme
    OpenDialog
    CloseDialog
    Toggle(id: string)
    Remove(id: string)
}

/// One task. `id` is the item key; `done` is its state.
type Todo = { id: string, title: string, done: bool }

/// A clickable control: the library's `button` names no event, so a
/// component with `on_click` is where a typed message meets a control.
@derive(View)
@prim(.Button)
component board_action {
    ..Box
    label: string
    on_click: Msg
    disabled: bool = false
}

/// A per-item checkbox: the label names the task and the click carries its
/// id. The library's `checkbox` binds no event, so the board spells the
/// component that does.
@derive(View)
@prim(.Checkbox)
component task_toggle {
    ..Box
    label: string
    checked: bool
    on_click: Msg
}

// ── state ───────────────────────────────────────────────────────

state filter: string = "all"
state dark: bool = false
state dialog_open: bool = false
state tasks: List<Todo> = [
    Todo { id: "t1", title: "Draft the spec", done: true },
    Todo { id: "t2", title: "Wire the event channel", done: false },
    Todo { id: "t3", title: "Land the wasm board", done: false },
    Todo { id: "t4", title: "Write the tour", done: true },
]

/// The counts are DERIVED from the list, never stored beside it.
fn done_count() -> int { [t for t in tasks if t.done].length }

fn open_count() -> int { [t for t in tasks if !t.done].length }

fn admits(t: Todo) -> bool {
    when {
        filter == "active" -> !t.done
        filter == "done" -> t.done
        _ -> true
    }
}

fn theme() -> Theme { if dark { dark_theme } else { default_theme } }

/// The last frame sent — an unchanged paint costs two bytes.
once fn painted() -> Live { live() }

// ── update: ONE match, every message ────────────────────────────

fn update(m: Msg) {
    match m {
        .ShowAll -> { filter = "all" },
        .ShowActive -> { filter = "active" },
        .ShowDone -> { filter = "done" },
        .ClearDone -> { tasks = [t for t in tasks if !t.done] },
        .ToggleTheme -> {
            dark = !dark
            // A mode is a whole stylesheet, so the next diff must resend it.
            painted().styled.set(false)
        },
        .OpenDialog -> { dialog_open = true },
        .CloseDialog -> { dialog_open = false },
        .Toggle(id) -> { tasks = [flipped(t, id) for t in tasks] },
        .Remove(id) -> { tasks = [t for t in tasks if t.id != id] },
    }
}

/// This task with its state flipped when it is the named one, unchanged
/// otherwise.
fn flipped(t: Todo, id: string) -> Todo {
    if t.id == id { t with { done: !t.done } } else { t }
}

// ── view: state in, tree out ────────────────────────────────────

fn theme_label() -> string { if dark { "Light mode" } else { "Dark mode" } }

fn tab_style(on: bool) -> Style {
    if on { sunk_style() } else { Style { radius: .S } }
}

fn title_style(done: bool) -> Style {
    if done { Style { color: .Muted } } else { Style { color: .Text } }
}

fn sunk_style() -> Style { Style { fill: .SurfaceSunk, radius: .S } }

fn spread_layout() -> Layout { Layout { gap: .M, align: .Center, distribute: .SpaceBetween } }

fn tab(label: string, m: Msg, on: bool) -> board_action {
    board_action { label: label, on_click: m, style: tab_style(on) }
}

fn header() -> row {
    row {
        layout: spread_layout()
        items: [
            column {
                layout: Layout { gap: .Xs }
                items: [
                    heading "Tasks" { rank: 1 },
                    text "Every task is a value; the screen is a function of state." {
                        style: Style { color: .Muted }
                    },
                ]
            },
            board_action { label: theme_label(), on_click: Msg.ToggleTheme, style: sunk_style() },
        ]
    }
}

fn filters() -> row {
    row {
        layout: Layout { gap: .S, align: .Center }
        items: [
            tab("All", Msg.ShowAll, filter == "all"),
            tab("Active", Msg.ShowActive, filter == "active"),
            tab("Done", Msg.ShowDone, filter == "done"),
            board_action {
                label: "Clear done",
                on_click: Msg.ClearDone,
                disabled: done_count() == 0,
                style: sunk_style(),
            },
        ]
    }
}

fn new_task() -> field {
    field "New task" { placeholder: "Type a task…" }
}

fn task_item(t: Todo) -> item {
    item {
        key: t.id
        layout: Layout { gap: .S, align: .Center, pad: around(.S) }
        items: [
            task_toggle {
                label: t.title,
                checked: t.done,
                on_click: Msg.Toggle(t.id),
                style: title_style(t.done),
            },
            board_action { label: "Remove", on_click: Msg.Remove(t.id), style: sunk_style() },
        ]
    }
}

fn visible() -> List<Todo> { [t for t in tasks if admits(t)] }

fn task_items() -> List<dyn View> {
    let shown = visible()
    if shown.is_empty() {
        [text "Nothing here yet." { style: Style { color: .Muted } }]
    } else {
        [task_item(t) for t in shown]
    }
}

fn task_list() -> list {
    list {
        layout: Layout { gap: .S }
        items: task_items()
    }
}

fn board_items() -> List<dyn View> {
    let done = progress "Done" {
        amount: done_count()
        max: tasks.length
    }
    let head: List<dyn View> = [done, filters(), new_task(), divider {}]
    let body: List<dyn View> = [task_list()]
    head.concat(body)
}

fn board() -> card {
    card "Board" {
        style: Style { fill: .SurfaceRaised, radius: .M }
        layout: Layout { gap: .M, pad: around(.M) }
        items: board_items()
    }
}

fn footer() -> row {
    row {
        layout: spread_layout()
        items: [
            text "${open_count()} open · ${done_count()} done of ${tasks.length}" {
                style: Style { color: .Muted }
            },
            board_action { label: "About", on_click: Msg.OpenDialog, style: sunk_style() },
        ]
    }
}

fn about() -> dialog {
    dialog "About" {
        open: dialog_open
        items: [
            heading "Task board" { rank: 2 },
            text "State lives in module `state`; the frame is its projection.",
            board_action { label: "Close", on_click: Msg.CloseDialog, style: sunk_style() },
        ]
    }
}

fn view() -> surface {
    surface {
        style: Style { fill: .Surface, radius: .M }
        layout: Layout { gap: .M, pad: around(.L) }
        items: [header(), board(), footer(), about()]
    }
}

fn paint() { avra_dom_frame(painted().diff(view().describe(), theme())) }

// ── the host's event seam ───────────────────────────────────────

/// The room a frame's text payload is written into by the host, and the
/// address it hands the host once. The host fills it and the program adopts
/// the octets — the one door a foreign buffer enters by.
const payload_room = 4096

once fn payload_box() -> Bytes { avra_bytes_with_room(payload_room) }

/// The host reads this once, then writes a text payload's UTF-8 octets at
/// the address before calling `avra_event` with their length.
export fn avra_payload_seat() -> Bytes { payload_box() }

/// A payload as the host's own TAGS: 0 is ABSENT, and `num`/`len` carry the
/// value. A dedicated absent tag, never a value, so a present zero or empty
/// text is never mistaken for no payload.
fn payload_of(tag: int, num: int, len: int) -> Payload? {
    when {
        tag == 1 -> Payload.Int(num)
        tag == 2 -> Payload.Bool(num != 0)
        tag == 3 -> payload_text(len)
        _ -> null
    }
}

/// The host-written octets as text. A payload that cannot be read as UTF-8
/// is a malformed frame: absent, never a wrong message.
fn payload_text(len: int) -> Payload? {
    let body? = avra_bytes_adopted(payload_box(), len).text() else { return null }
    Payload.Text(body)
}

/// The host's call: the site is the message's identity, the tag and value
/// are the payload it echoed, `update` dispatches, and the frame follows.
export fn avra_event(site: int, what: int, tag: int, num: int, len: int) {
    let e? = event_at(view().describe(), site, what) else { return }
    let m? = Msg.from_site(e.site, payload_of(tag, num, len)) else { return }
    update(m)
    paint()
}

/// The host's first call, after the reactor is initialized: one paint.
export fn avra_start() { paint() }
