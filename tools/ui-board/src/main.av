//! M1 — the board, as a wasm app. `main` paints once; an event repaints only
//! what changed. The host applies each frame to the live tree.
//!
//! The frame row is a HOST import (`avra:rt.avra_dom_frame`); its seat is a
//! `Bytes`, so the pointer names its box and the glue reads the length from
//! the header — no (ptr,len) pair to keep in step.
use @std.meta.{derive}
use @std.ui.components.{heading, item, button}
use @std.ui.realize.dom.frame.{Live, live, event_at}
use @std.ui.realize.messages.{Messages}
use @std.ui.realize.prim.{prim}
use @std.ui.realize.view.{View}
use @std.ui.style.box.{Box}
use @std.ui.style.theme.{default_theme}

extern fn avra_dom_frame(frame: Bytes)

/// The app's messages. `@derive(Messages)` mints each one's content-addressed
/// site, so the tree carries a typed message and `update` is the ONE
/// exhaustive dispatch.
@derive(Messages)
enum Msg {
    Toggle
}

/// The screen's own place, spread into the board: a `state` field holds a
/// Cell, so a read answers the value and a write lands in the one slot.
type BoardState = {
    state show: string = "all",
}

@derive(View)
@prim(.Surface)
component board {
    ..Box
    ..BoardState
    on_click: Msg = Msg.Toggle
    items: List<dyn View> = []
}

/// THE STATE the screen is a function of: module `state` is one place every
/// reader shares, read by name and assigned in place.
state filter: string = "all"

/// The last frame sent — an unchanged paint costs two bytes.
once fn painted() -> Live { live() }

/// The app's behaviour: ONE match, every message. Adding a `Msg` breaks the
/// build here, on purpose — the tree can only name a message that dispatches.
fn update(m: Msg) {
    match m { .Toggle -> toggle() }
}

fn toggle() { filter = if filter == "all" { "done" } else { "all" } }

/// The screen: state in, tree out. Called again on every event, so its ids
/// are the ids the host was last told.
fn view() -> board {
    board {
        show: filter,
        on_click: Msg.Toggle,
        items: [heading "Tasks — ${filter}" { rank: 1 }, item { button "Toggle" }],
    }
}

fn paint() { avra_dom_frame(painted().diff(view().describe(), default_theme)) }

/// The host's call: `site` is the content hash the frame named (never the
/// id it subscribed along), `what` the kind. The message is resolved from
/// the typed enum — the site is the message's identity — and `update`
/// dispatches it. A node inserted above moves nothing.
export fn avra_event(site: int, what: int) {
    let e? = event_at(view().describe(), site, what) else { return }
    let m? = Msg.from_site(e.site) else { return }
    update(m)
    paint()
}

/// The host's first call, after the reactor is initialized: one paint.
export fn avra_start() { paint() }
