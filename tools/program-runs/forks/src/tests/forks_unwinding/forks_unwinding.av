// proves nothing of its own: a program that forks two processes which return out of it rather
// than leave, the shape a harness that runs it must outlive
extern fn avra_cores_group(count: int) -> int
extern fn avra_cores_fork(group: int, serving: int) -> int
extern fn avra_cores_heard(group: int, core: int) -> int

fn waited(g: int) -> int {
    while avra_cores_heard(g, 0) != 0 || avra_cores_heard(g, 1) != 0 {}
    2
}

let g = avra_cores_group(2)
let core = avra_cores_fork(g, 0 - 1)
if core < 2 { "a core returned" } else { "parent heard ${waited(g)}" }
