use @std.io.{env}
use @std.process.{cmd, inherited, status_of, tool_at}
use @std.text.{parse_int, with_room}
use @std.time.{ms, sleep}

/// The number an environment variable names, or `fallback`.
fn env_int(name: string, fallback: int) -> int { parse_int(env(name) ?? "") ?? fallback }

/// One buffer of exactly `mib` MiB, in one allocation, however the compiler lays out a collection.
fn held(mib: int) -> Bytes { with_room(mib * 1048576) }

/// A buffer of `mib` MiB made and dropped: its size in MiB.
fn peaked(mib: int) -> int { mib + held(mib).length }

/// This program run again as a child holding `mib` MiB: its exit status and what it said.
fn child_said(mib: int) -> string {
    let c = cmd(tool_at("probe", env("POOL_SELF") ?? ""), []) with { env: inherited().with_var("POOL_MB", "${mib}").with_var("PEAK_MB", "0").with_var("CHILD_MB", "0") }
    match c.outcome() {
        .Ok(ran) -> "child ${status_of(ran.exit)}: ${ran.out.stdout}${ran.out.stderr}",
        .Err(_) -> "child unstarted",
    }
}

if env_int("PEAK_MB", 0) > 0 {
    println("peaked ${peaked(env_int("PEAK_MB", 0))} MiB")
}
if env_int("CHILD_MB", 0) > 0 {
    println(child_said(env_int("CHILD_MB", 0)))
}
let mib = env_int("POOL_MB", 100)
let buffer = held(mib)
println("allocated ${mib} MiB")
sleep(ms(env_int("HOLD_MS", 0)))
// the buffer is read after the hold, so it stands through it
println("done ${mib + buffer.length} MiB")
