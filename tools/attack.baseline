# THE SURVIVOR BASELINE. One line per mutant `avra attack`'s malformed
# class ACCEPTS: <feature><TAB><source><TAB><reason>. A survivor is not
# a failure — it may be a VALID program — so the tolerance law stays and
# this records the accepted set: a NEW survivor is refused, and an entry
# that now REFUSES is stale. The baseline lists sites, never counts.
grammar_lit	{ "s" }	valid mutant: `{ "s" }` is a BLOCK — deleting `grammar` leaves a valid program
impls	trait x < x , x , > { \n \n }	valid mutant: an empty generic `trait` declaration
impls	trait x < x , x , > { \n \n } \n	valid mutant: an empty generic trait declaration and a blank line
impls	trait x < x , x , > { \n }	valid mutant: an empty generic trait declaration
impls	trait x < x , x , > { \n } \n \n	valid mutant: an empty generic trait declaration
impls	trait x < x , x , > { } \n \n	valid mutant: an empty generic trait declaration
impls	trait x < x , x > { \n } \n	valid mutant: a type parameter list's trailing comma is optional
impls	trait x < impl , x , > { \n } \n	avra-8sb5.57.166
impls	trait x < x , impl , > { \n } \n	avra-8sb5.57.166
maps	\n { }	valid mutant: an empty map literal
maps	{ \n \n }	valid mutant: an empty map literal
maps	{ }	valid mutant: an empty map literal
maps	{ } \n	valid mutant: an empty map literal
specs	spec "s" { \n \n }	valid mutant: an empty `spec` declaration
specs	spec "s" { \n \n } \n	valid mutant: an empty `spec` declaration
specs	spec "s" { \n }	valid mutant: an empty `spec` declaration
specs	spec "s" { \n } \n \n	valid mutant: an empty `spec` declaration
specs	spec "s" { } \n \n	valid mutant: an empty `spec` declaration
when_expr	{ \n }	valid mutant: an empty block — deleting `when` leaves a valid program
bool_lit	false	valid mutant: `false` is the OTHER boolean literal
bool_lit	true	valid mutant: `true` is the OTHER boolean literal
impls	trait impl < x , x , > { \n } \n	valid mutant: a `trait` named `impl` — the keyword IS a name there
components	\n	valid mutant: an empty program — the instance form deleted down to its line break
