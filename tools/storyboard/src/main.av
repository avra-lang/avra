//! The storyboard on a web page: every view `@std/ui` declares, in every case its stories tell, each
//! case the claims' baseline pins shown as pinned.
use @std.meta.{embed}
use @std.ui.web.{mount}
use @std.ui.tree.viewed.{views}
use @std.ui.tree.story.{stories}
use @std.ui_gallery.{Shelf, storyboard, shelves, pins_of}

/// The claims' baseline: what a ruling still owes, case by case.
const pinned: string = embed("../pinned.txt")

/// Every story told once: a case's places are shared like a caller's, so a gesture on one moves
/// what the next telling would draw, and the page draws the cases it was first told.
once fn told() -> List<Shelf> { shelves(views, stories) }

fn page() -> storyboard { storyboard told() { pins: pins_of(pinned) } }

mount(page)
