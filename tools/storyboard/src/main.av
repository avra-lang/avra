//! The storyboard on a web page: every view `@std/ui` declares, in every case its stories tell.
use @std.ui.web.{mount}
use @std.ui.tree.viewed.{views}
use @std.ui.tree.story.{stories}
use @std.ui_gallery.{storyboard, shelves}

fn page() -> storyboard { storyboard shelves(views, stories) }

mount(page)
