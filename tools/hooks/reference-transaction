#!/bin/sh
# Main lives on GitHub, so a local refs/heads/main only ever follows it:
# any update of it that does not land exactly on origin/main is refused.
# A deliberate repair says why in AVRA_MAIN_OVERRIDE, which is printed.
[ "$1" = "prepared" ] || exit 0
bad=0
while read -r old new ref; do
    [ "$ref" = "refs/heads/main" ] && [ "$old" != "$new" ] \
        && [ "$new" != "$(git rev-parse -q --verify refs/remotes/origin/main)" ] && bad=1
done
[ "$bad" -eq 1 ] || exit 0
if [ -n "${AVRA_MAIN_OVERRIDE:-}" ]; then
    echo "main-guard: main moved by hand — $AVRA_MAIN_OVERRIDE" >&2
    exit 0
fi
echo "main-guard: local main only follows origin/main; work lands through \`sh tools/work land\`" >&2
exit 1
