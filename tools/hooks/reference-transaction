#!/bin/sh
# Main moves only by a landing: any update of refs/heads/main — a commit on
# main's checkout, a reset, a merge, an update-ref, from any worktree — is
# refused unless tools/land.sh made it (AVRA_LANDING=1, or land.sh among
# this process's ancestors, which a land.sh started before the flag also
# is). A deliberate repair says why in AVRA_MAIN_OVERRIDE, which is printed.
[ "$1" = "prepared" ] || exit 0
[ "${AVRA_LANDING:-}" = "1" ] && exit 0
touches_main=0
while read -r old new ref; do
    [ "$ref" = "refs/heads/main" ] && [ "$old" != "$new" ] && touches_main=1
done
[ "$touches_main" -eq 1 ] || exit 0
p=$PPID
i=0
while [ "$p" -gt 1 ] && [ $i -lt 12 ]; do
    case "$(ps -o command= -p "$p" 2>/dev/null)" in *tools/land.sh*) exit 0 ;; esac
    p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
    [ -n "$p" ] || break
    i=$((i + 1))
done
if [ -n "${AVRA_MAIN_OVERRIDE:-}" ]; then
    echo "main-guard: main moved by hand — $AVRA_MAIN_OVERRIDE" >&2
    exit 0
fi
echo "main-guard: refs/heads/main moves only through \`sh tools/land.sh <branch>\`; work on a branch in its own worktree" >&2
exit 1
