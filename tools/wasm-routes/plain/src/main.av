//! The page without a served model: a plain record and the route data written by hand.
use @std.http_message.route.{Routes, routes_at}

type Todo = { id: int = 0, title: string, done: bool = false }

let routes: Routes<Todo> = routes_at("/tasks")
println("${Todo { title: "a" }.title} ${routes.list.path} ${routes.find.path}")
