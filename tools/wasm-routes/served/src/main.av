//! The page that imports a served model: the same record under `@crud`, its route data from the derive. Nothing
//! of the server — handlers, the database, the router — may follow it onto the page.
use @std.crud.{crud}

@crud
type Todo = { id: int = 0, title: string, done: bool = false }

let routes = Todo.paths("/tasks")
println("${Todo { title: "a" }.title} ${routes.list.path} ${routes.find.path}")
