//! The page that reads the served model's route data: the descriptor is what it adds, and nothing of the server —
//! handlers, the database, the router — may follow it onto the page.
use @std.crud.{crud}

@crud
type Todo = { id: int = 0, title: string, done: bool = false }

let routes = Todo.paths("/todos")
println("${Todo { title: "a" }.title} ${routes.list!.path} ${routes.find!.path}")
