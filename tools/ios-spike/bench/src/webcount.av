//! How many rows a paint describes on the web page: a first paint, a one-row
//! window move, and a toggle of one row, each counted by the walk's own tally.
use rows.{fill, windowed_view, mark_first}
use @std.ui.realize.dom.live.{live}

export fn web_counts() -> List<string> {
    fill(10000)
    let page = live()
    page.stands.first_rows(40)
    let first = page.drawn(windowed_view())
    let _ = page.patches_drawn(first)
    let said = ["first paint: ${page.stands.built()} rows described"]
    let path? = page.stands.windows().first() else { return said.concat(["no window"]) }
    let list? = page.stands.find(path) else { return said.concat(["no list"]) }
    list.measured(40)
    list.windowed(100, 140)
    let _ = page.patches_drawn(page.drawn(windowed_view()))
    list.windowed(101, 141)
    let _ = page.patches_drawn(page.drawn(windowed_view()))
    let moved = page.stands.built()
    mark_first()
    let _ = page.patches_drawn(page.drawn(windowed_view()))
    said
        .concat(
            [
                "one-row window move: ${moved} rows described",
                "one row toggled: ${page.stands.built()} rows described",
            ],
        )
}
