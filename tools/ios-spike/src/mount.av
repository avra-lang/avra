//! The UIKit host's `mount`: std-ui's app, standing and differ over a neutral
//! frame the host draws; a tap echoes back as the node's number and seat.
use @std.ui.app.{App, Msg, owned_app, stood}
use @std.ui.native.sources.{opened, served}
use @std.ui.native.net.{over_http, unwired}
use @std.http_message.message.{Method, Reply, Request}
use @std.io.{env}
use @std.ui.realize.native.live.{NativeLive, native_live}
use @std.ui.tree.identity.{Owner, NodeId}
use @std.ui.tree.node.{Node, Said}
use @std.ui.tree.seats.{seat_numbered}
use @std.ui.tree.view.{View}
use @std.ui.tree.standing.{Standing}
use @std.ui.tree.identity.{Stand}
use @std.ui.realize.native.patch.{NativePatch, moves_boxes}
use @std.time.{now_ns}
use frame.{neutral, said_directly}
use kept.{paint_begun, kept_tally}
use kit.{rects, placed_directly, remembered, solve_ns, rects_split}

extern fn avra_spike_attach()
extern fn avra_spike_frame(records: string)
extern fn avra_spike_log(words: string)
extern fn avra_spike_begin()
extern fn avra_spike_end()
extern fn avra_spike_content_still()
extern fn avra_mem_live() -> int

/// What a tap reaches: the page the program paints, once it stands.
once fn page() -> Cell<fn(int, int) -> bool> { Cell.new((_id: int, _seat: int) -> false) }

/// The host's echo: the node numbered `id` (one more than the page's) spoke
/// at seat `seat`. Its handler runs as a turn the program's loop takes.
extern fn avra_spike_tapped(id: int, seat: int) { let _ = (page().get())(id, seat) }

/// What a host's change of size reaches: the last tree placed again.
once fn replaced() -> Cell<fn() -> bool> { Cell.new(() -> false) }

/// The host's measures went stale — its width, its text size, an inset — so
/// the page is placed again as a turn of the program's loop.
extern fn avra_spike_resized() { let _ = (replaced().get())() }

/// What a control said: the page's echo for a typed or flipped control.
once fn heard() -> Cell<fn(int, int, Said?) -> bool> { Cell.new((_id: int, _seat: int, _s: Said?) -> false) }

/// The host's echo of a control that spoke: `flag` 0 says `words`, 1 off, 2 on.
extern fn avra_spike_said(id: int, seat: int, flag: int, words: string) {
    let s: Said = if flag == 0 { Said.Text(words) } else { Said.Flag(flag == 2) }
    let _ = (heard().get())(id, seat, s)
}

/// A control on `node` at `seat` said `s`, left as a turn for the program's loop.
fn spoke(app: App, at: NativeLive, node: NodeId, seat: int, s: Said?) -> bool {
    let seated? = seat_numbered(seat) else { return false }
    app.send(Msg.Turn(() -> at.fire(node, seated, s), "${node.n}"))
}

/// A tap on `node` at `seat`, left as a turn for the program's loop.
fn tapped(app: App, at: NativeLive, node: NodeId, seat: int) -> bool {
    let s? = seat_numbered(seat) else { return false }
    app.send(Msg.Turn(() -> at.fire(node, s, null), "${node.n}"))
}

/// The server a route is asked of: `AVRA_SPIKE_SERVER`, a scheme and host
/// with no trailing slash.
once fn server() -> string { env("AVRA_SPIKE_SERVER") ?? "" }

/// `r` over `@std/http`, a same-origin route made absolute on the server.
fn based(r: Request) -> Result<Reply, string> {
    avra_spike_log("net called for ${r.url}, server `${server()}`")
    if server() == "" { return unwired(r) }
    let url = if r.url.starts_with("/") { server() + r.url } else { r.url }
    avra_spike_log("net asks ${url}")
    let answer = over_http(r with { url: url })
    match answer {
        .Ok(reply) -> avra_spike_log("net answered ${reply.status}"),
        .Err(why) -> avra_spike_log("net failed: ${why}"),
    }
    answer
}

/// `route`'s reply as text, asked once over the spike's network: null when
/// nothing answered.
export fn read_once(route: string) -> string? {
    let r = Request { method: Method.Get, url: route }
    match based(r) { .Ok(reply) -> reply.body.text_lossy(), .Err(_) -> null }
}

/// The last tree the page showed.
once fn shown_root() -> Cell<List<Node>> { Cell.new([]) }

/// The last tree placed again in the host's width.
fn placed_again(at: NativeLive) -> bool {
    let root? = shown_root().get().first() else { return false }
    avra_spike_frame(rects(root, at.page.get()))
    false
}

/// Nothing to do between turns.
fn idle() {}

/// `view` drawn by the UIKit host until the program's loop ends.
export fn mount<V: View>(view: fn() -> V, first_rows: int = 0) {
    avra_spike_attach()
    let at = native_live()
    if first_rows > 0 { at.stands.first_rows(first_rows) }
    let on_screen: Cell<List<Owner>> = Cell.new([])
    let app = owned_app(
        () -> Timed { inner: view() },
        (root: Node) -> {
            let t0 = now_ns()
            let live0 = avra_mem_live()
            let patches = at.patches(root)
            let t1 = now_ns()
            on_screen.set(at.owners())
            let moving = moves_boxes(patches) || shown_root().get().is_empty()
            if text_frame() {
                let said = neutral(patches)
                let t2 = now_ns()
                let placed = if moving { rects(root, at.page.get()) } else { "content still" }
                let t3 = now_ns()
                if !patches.is_empty() { avra_spike_frame(said) }
                avra_spike_frame(placed)
                phases().set([t1 - t0, t2 - t1, t3 - t2])
            } else {
                avra_spike_begin()
                said_directly(patches)
                let t2 = now_ns()
                if moving { placed_directly(root, at.page.get()) } else { avra_spike_content_still() }
                let t3 = now_ns()
                avra_spike_end()
                phases().set([t1 - t0, t2 - t1, t3 - t2])
            }
            shown_root().set([root])
            let ph = phases().get()
            avra_spike_log(paint_line(patches, ph[0], ph[1], ph[2], avra_mem_live() - live0))
        },
        on_screen,
        at.stands,
    )
    stood(app)
    let inbox = opened(app, based)
    page().set((id: int, seat: int) -> tapped(app, at, NodeId { n: id - 1 }, seat))
    heard().set((id: int, seat: int, s: Said?) -> spoke(app, at, NodeId { n: id - 1 }, seat, s))
    replaced()
        .set(
            () -> app
                .post_unowned(
                    () -> {
                        remembered().forget()
                        placed_again(at)
                    },
                ),
        )
    scrolled_to()
        .set(
            (from: int, to: int, extent: int) -> app
                .post_unowned(() -> window_moved(app, from, to, extent)),
        )
    app.paint()
    served(app, inbox, idle)
}

/// One paint's phases in microseconds and its counters, as the host logs it.
fn paint_line(patches: List<NativePatch>, lower: int, serialize: int, place: int, bytes: int) -> string {
    let facts = [p for p in patches if is_fact(p)].length
    let made = [p for p in patches if is_create(p)].length
    "paint tree_us=${tree_ns().get() / 1000} lower_diff_us=${lower / 1000} serialize_us=${serialize / 1000} place_us=${place / 1000} patches=${patches.length} facts=${facts} creates=${made} ${kept_tally()} page_get_us=${page_get_ns().get() / 1000} solve_us=${solve_ns().get() / 1000} ${rects_split().get()} rows_built=${built_rows().get()} nodes=${node_count(shown_root().get())} ${remembered().tally()} live_bytes_delta=${bytes}"
}

fn is_fact(p: NativePatch) -> bool {
    match p {
        .SetFact(_, _) -> true,
        .Create(_, _) or .DropFact(_, _, _) or .Place(_, _, _) or .Remove(_) or .Listen(_, _) or .Unlisten(_, _) -> false,
    }
}

fn is_create(p: NativePatch) -> bool {
    match p {
        .Create(_, _) -> true,
        .SetFact(_, _) or .DropFact(_, _, _) or .Place(_, _, _) or .Remove(_) or .Listen(_, _) or .Unlisten(_, _) -> false,
    }
}

/// Whether the host is told by the text frame, for reading (`AVRA_SPIKE_TEXT=1`),
/// rather than by direct calls.
once fn text_setting() -> string { env("AVRA_SPIKE_TEXT") ?? "" }

fn text_frame() -> bool { text_setting() == "1" }

/// The last paint's lower + diff, telling and placing, in nanoseconds.
once fn phases() -> Cell<List<int>> { Cell.new([0, 0, 0]) }

/// How long reading the page took, in nanoseconds.
once fn page_get_ns() -> Cell<int> { Cell.new(0) }

/// How many rows windowed lists built in the last walk.
once fn built_rows() -> Cell<int> { Cell.new(0) }

/// The nodes in the trees shown.
fn node_count(roots: List<Node>) -> int { roots.fold(0, (a: int, n: Node) -> a + 1 + node_count(n.children)) }

/// How long the last tree took to build, in nanoseconds.
once fn tree_ns() -> Cell<int> { Cell.new(0) }

/// A view whose drawing is timed: what it draws is its inner view's.
type Timed = { inner: dyn View }

impl View for Timed {
    fn stand() -> Stand { self.inner.stand() }

    fn describe(at: Standing) -> List<Node> {
        paint_begun()
        let t = now_ns()
        let drawn = self.inner.describe(at)
        tree_ns().set(now_ns() - t)
        built_rows().set(at.built())
        drawn
    }
}

/// What the host's scroll reaches: the windowed list's new rows.
once fn scrolled_to() -> Cell<fn(int, int, int) -> bool> { Cell.new((_f: int, _t: int, _e: int) -> false) }

/// The host scrolled the windowed list to rows `from` up to `to`, each `extent`
/// points tall.
extern fn avra_spike_scrolled(from: int, to: int, extent: int) { let _ = (scrolled_to().get())(from, to, extent) }

/// The first windowed list moved to rows `from` up to `to`.
fn window_moved(app: App, from: int, to: int, extent: int) -> bool {
    let path? = app.stands.windows().first() else { return false }
    app.scrolled(path, from, to, extent, null)
}
