//! Slice 1: a label Avra supplies and a button whose press changes a `state`,
//! drawn by the UIKit host (`mount.av`).
use @std.ui.components.{text, button}
use mount.{mount, read_once}
use @ui.board.{tasks_written, view}
use rows.{fill, windowed_view}
use @std.text.{parse_int}
use @std.io.{env}
use @std.time.{ms, sleep}

extern fn avra_spike_tick(n: int)

component counter(label: string) {
    state n: int = 0
    text "${self.label}: ${self.n}"
    button "${self.label}+" { on press { self.n = self.n + 1 } }
}

/// The one screen.
fn shown() -> counter { counter "taps" }

/// A handler the host runs INSIDE its own call, for an answer it needs before
/// it returns (a text field's delegate): it runs to its end there, and one that
/// waits is refused by the runtime.
extern fn avra_spike_sync(waits: int) -> int {
    if waits == 1 { sleep(ms(1)) }
    42
}

/// A task that ticks every 50 ms, told to the host each time.
fn ticked() -> int {
    mut n = 0
    while n < 400 {
        sleep(ms(50))
        n = n + 1
        avra_spike_tick(n)
    }
    n
}

/// `n` tasks as the board's server would send them, every third done.
fn seeded(n: int) -> string? { "[${["{\"id\":${i + 1},\"title\":\"Task ${i + 1}\",\"done\":${if i % 3 == 0 { "true" } else { "false" }}}" for i in 0..n].join(",")}]" }

/// A task that spins on the CPU and never waits.
fn spun() -> int {
    mut x = 0
    while x >= 0 { x = (x + 1) % 1000000 }
    x
}

let ticker = spawn ticked()
let spinner = if env("AVRA_SPIKE_SPIN") == "1" { spawn spun() } else { spawn 0 }
let board_rows = parse_int(env("AVRA_SPIKE_ROWS") ?? "") ?? 0
if env("AVRA_SPIKE_BOARD") == "2" {
    fill(if board_rows > 0 { board_rows } else { 10000 })
    mount(windowed_view, 40)
} else if env("AVRA_SPIKE_BOARD") == "1" {
    let tasks = if board_rows > 0 { seeded(board_rows) } else { read_once("/tasks") }
    if tasks != null { let _ = tasks_written(tasks!) }
    mount(view)
} else {
    mount(shown)
}
println("served ${ticker.await} ${spinner.await}")
