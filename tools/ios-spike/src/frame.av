//! The neutral frame: a native page's patches as records a host reads, one a
//! line — `create <id> <prim>`, `fact <id> <code> <under> <scalar>`, `drop
//! <id> <code> <under>`, `place <id> <parent> <after>`, `remove <id>`,
//! `listen <id> <seat> <kind>`, `unlisten <id> <seat>`. An id is one more than
//! the page's number, so 0 names none; `under` is an interaction's word or
//! `-`; a scalar is `t <words>`, `f 0|1`, `n <int>` or `x <float>`. Words
//! carry no line break.
use @std.ui.realize.native.patch.{NativePatch}
use @std.ui.realize.native.fact.{Fact, Scalar}
use @std.ui.style.style.{Interaction}
use @std.ui.tree.identity.{NodeId}
use @std.ui.tree.seats.{row_at}

/// The frame `patches` say, as the host reads it.
export fn neutral(patches: List<NativePatch>) -> string { [recorded(p) for p in patches].join("\n") }

fn recorded(p: NativePatch) -> string {
    match p {
        .Create(id, prim) -> "create ${wire_id(id)} ${prim.word()}",
        .SetFact(id, f) -> "fact ${wire_id(id)} ${f.what.code()} ${under_word(f.under)} ${scalar_words(f.holds)}",
        .DropFact(id, what, under) -> "drop ${wire_id(id)} ${what.code()} ${under_word(under)}",
        .Place(id, parent, after) -> "place ${wire_id(id)} ${wire_id_of(parent)} ${wire_id_of(after)}",
        .Remove(id) -> "remove ${wire_id(id)}",
        .Listen(id, seat) -> "listen ${wire_id(id)} ${seat.number()} ${row_at(seat).prim.word()}",
        .Unlisten(id, seat) -> "unlisten ${wire_id(id)} ${seat.number()}",
    }
}

fn under_word(i: Interaction?) -> string {
    let named? = i else { return "-" }
    named.word()
}

fn scalar_words(s: Scalar) -> string {
    match s {
        .Text(t) -> "t ${t.replace("\n", " ")}",
        .Flag(on) -> if on { "f 1" } else { "f 0" },
        .Number(n) -> "n ${n}",
        .Fraction(x) -> "x ${x}",
    }
}

fn wire_id(id: NodeId) -> int { id.n + 1 }

fn wire_id_of(id: NodeId?) -> int {
    let named? = id else { return 0 }
    wire_id(named)
}
