//! The neutral frame: std-ui's DOM patches as records a native host reads,
//! one a line — `create <id> <tag>`, `text <id> <words>`, `place <id>
//! <parent> <after>`, `remove <id>`, `listen <id> <seat> <prim>`,
//! `unlisten <id> <seat>`, `attr <id> <name> <value>`, `dropattr <id> <name>`,
//! `prop <id> <name> <value>`, `call <id> <verb>`, `var <id> <property>
//! <value>`, `dropvar <id> <property>`, `style <bytes>`, `adopt <kinds>`. An id
//! is one more than the page's number, so 0 names none. Words carry no line
//! break.
use @std.ui.realize.dom.patch.{Patch, Held}
use @std.ui.tree.identity.{NodeId}
use @std.ui.tree.seats.{row_at}

/// The frame `patches` say, as the host reads it.
export fn neutral(patches: List<Patch>) -> string {
    [line for p in patches for line in recorded(p)].join("\n")
}

/// One patch's records.
fn recorded(p: Patch) -> List<string> {
    match p {
        .Create(id, tag) -> ["create ${wire_id(id)} ${tag.word()}"],
        .CreateText(id, content) -> ["create ${wire_id(id)} text", "text ${wire_id(id)} ${unbroken(content)}"],
        .Place(id, parent, after) -> ["place ${wire_id(id)} ${wire_id_of(parent)} ${wire_id_of(after)}"],
        .Remove(id) -> ["remove ${wire_id(id)}"],
        .SetText(id, content) -> ["text ${wire_id(id)} ${unbroken(content)}"],
        .Listen(id, to) -> ["listen ${wire_id(id)} ${to.action.seat.number()} ${row_at(to.action.seat).prim.word()}"],
        .Unlisten(id, seat) -> ["unlisten ${wire_id(id)} ${seat.number()}"],
        .SetAttr(id, name, value) -> ["attr ${wire_id(id)} ${name.word()} ${unbroken(value)}"]
            .concat(roles(id, name.word(), value)),
        .DropAttr(id, name) -> ["dropattr ${wire_id(id)} ${name.word()}"],
        .SetProp(id, name, value) -> ["prop ${wire_id(id)} ${name.word()} ${held_word(value)}"],
        .Call(id, verb) -> ["call ${wire_id(id)} ${verb}"],
        .SetVar(id, property, value) -> ["var ${wire_id(id)} ${property} ${unbroken(value)}"],
        .DropVar(id, property) -> ["dropvar ${wire_id(id)} ${property}"],
        .Style(css) -> ["style ${css.length}"],
        .Adopt(kinds, _) -> ["adopt ${kinds.join(",")}"],
    }
}

/// The roles a class names, as records a native host draws by: `tone <id>
/// <tone>`, `ink <id> <ink>`, `radius <id> <size>`, `gap <id> <size>`, `pad
/// <id> <size>` per side (`pad-start`, `pad-end`, `pad-top`, `pad-bottom`), `dir <id> row|col`. A class word with a state prefix
/// (`hover:`) or no role is left to the page.
fn roles(id: NodeId, name: string, value: string) -> List<string> {
    if name != "class" { return [] }
    [r for w in value.split(" ") for r in role_of(wire_id(id), w)]
}

/// One class word's role record, if it names one.
fn role_of(id: int, w: string) -> List<string> {
    if w == "dir-row" { return ["dir ${id} row"] }
    if w == "dir-col" { return ["dir ${id} col"] }
    let r? = [p for p in prefixes() if w.starts_with(p.prefix)].first() else { return [] }
    ["${r.kind} ${id} ${w.substring(r.prefix.length, w.length)}"]
}

/// A class word's prefix and the record it becomes.
type Prefix = { prefix: string, kind: string }

/// Every role a class word carries a native host.
fn prefixes() -> List<Prefix> {
    [
        Prefix { prefix: "fill-", kind: "tone" },
        Prefix { prefix: "color-", kind: "ink" },
        Prefix { prefix: "radius-", kind: "radius" },
        Prefix { prefix: "gap-", kind: "gap" },
        Prefix { prefix: "pis-", kind: "pad-start" },
        Prefix { prefix: "pie-", kind: "pad-end" },
        Prefix { prefix: "pt-", kind: "pad-top" },
        Prefix { prefix: "pb-", kind: "pad-bottom" },
    ]
}

/// A held value as one word run.
fn held_word(h: Held) -> string {
    match h { .Text(t) -> unbroken(t), .Flag(on) -> if on { "true" } else { "false" } }
}

fn wire_id(id: NodeId) -> int { id.n + 1 }

fn wire_id_of(id: NodeId?) -> int {
    let named? = id else { return 0 }
    wire_id(named)
}

/// Words on one line.
fn unbroken(s: string) -> string { s.replace("\n", " ") }
