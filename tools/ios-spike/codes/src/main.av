//! The UIKit host's fact codes, written from `What.coded()` so a number moved
//! in Avra moves in the host: `avra run tools/ios-spike/codes > tools/ios-spike/host/avra_facts.gen.h`.
use @std.ui.realize.native.fact.{What}

println("// Generated from std-ui's native `What` by tools/ios-spike/codes: never edited.")
println("#pragma once")
for c in What.coded() { println("#define AVRA_FACT_${c.word} ${c.code}") }
