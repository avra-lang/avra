// A crud model's doors, read as data with no database, as a page reads them. `@std/crud` imports
// `@std/sqlite`, whose C a program links only where it calls into it: this one carries none.
use @std.crud.{crud}

@crud
type Note = { id: int = 0, text: string }

let doors = Note.paths("/notes")
println(doors.list?.path ?? "none")
