// Text, a list and a map, and no task.
fn tally(words: List<string>) -> Map<string, int> {
    mut seen: Map<string, int> = {}
    for w in words { seen.set(w, (seen.get(w) ?? 0) + 1) }
    seen
}

let words = "the quick brown fox jumps over the lazy dog the end".split(" ")
let seen = tally(words)
let lines = ["${k}=${seen.get(k) ?? 0}" for k in seen.keys()]
println("${words.length} words, ${seen.length} distinct: ${lines.join(" ")}")
