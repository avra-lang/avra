index 93c9e7a3..b75ca5cf 100644
--- a/runtime/avra_box.h
+++ b/runtime/avra_box.h
@@ -39,11 +39,23 @@ enum { MARK_OWNED = 1, MARK_ABSENT = 2 };
 // and a LENGTH — a string's text length, a record's payload bytes.
 typedef struct {
     uint32_t tag;
-    int32_t kind;
+    int32_t kind : 8;
+    uint32_t ver : 24;
     int32_t rc;
     uint32_t len;
 } Header;
 
+// A box's VERSION: how many times it was written or opened for writing,
+// modulo 2^24, in the 24 bits above its kind. It rides the kind's word,
+// so a bump is one add on a word the write's reader already holds, and the
+// kind's sign (immortal below zero) is untouched by the carry out of bit 31.
+typedef uint32_t __attribute__((may_alias)) AvraWord;
+#define AVRA_VER_ONE 256u
+static inline void avra_box_touch(void* payload) {
+    AvraWord* w = (AvraWord*)((Header*)payload - 1) + 1;
+    *w += AVRA_VER_ONE;
+}
+
 // A slot array: `cap` cells at `data`, `len` of them written, and
 // one MARK byte per cell after the cells: `MARK_OWNED` when the cell
 // holds a managed value the reclaim releases, `MARK_ABSENT` when it
