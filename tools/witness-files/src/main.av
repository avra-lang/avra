//! Every registered code's witness, one JSON object a line: its code, its shape, its files by path,
//! and why no source reaches it where none does — what tools/witness_program_differential.sh lays
//! out on disk and builds on both paths.
use @std.avrac.compiler.dev.{witness_files}
use @std.json.{Field, Json, to_text}

for w in witness_files() {
    println(
        to_text(
            Json
                .Obj(
                    [
                        Field { key: "code", value: Json.Str(w.code) },
                        Field { key: "shape", value: Json.Str(w.shape) },
                        Field { key: "why", value: Json.Str(w.why) },
                        Field {
                            key: "files",
                            value: Json
                                .Obj(
                                    [Field { key: path, value: Json.Str(text) } for path, text in w.files],
                                ),
                        },
                    ],
                ),
        ),
    )
}
