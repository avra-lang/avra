// a program whose forked child leaves holding boxes it never freed, while the program itself frees
// all it made: the ledger the soundness check reads is the program's, and the child says none

extern fn avra_cores_group(count: int) -> int
extern fn avra_cores_fork(group: int, serving: int) -> int
extern fn avra_cores_leave(group: int, core: int, accepted: int, err: int) -> int
extern fn avra_cores_heard(group: int, core: int) -> int

fn kept(n: int) -> List<string> { ["a${n}", "b${n}"] }

let g = avra_cores_group(1)
let core = avra_cores_fork(g, 0 - 1)
if core == 0 {
    let held = kept(7)
    let _ = avra_cores_leave(g, core, held.length, 0)
}
while avra_cores_heard(g, 0) != 0 {}
println("heard")
