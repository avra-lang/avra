//! Two views asking the same GET: the page sends one request and both show its answer. A second ask sends
//! the version it holds, and a write makes the next ask answer new.
use @std.http_message.message.{Body, Reply, Request}
use @std.ui.app.{Async, Fetch, fetch, fetched}
use @std.ui.components.{button, column, text}
use @std.ui.web.{mount}

state left: Fetch<int> = fetch()
state right: Fetch<int> = fetch()
state added: Fetch<int> = fetch()

fn sized(r: Reply) -> Result<int, string> { .Ok(r.body.length) }

fn words(a: Async<int>) -> string {
    match a {
        .Idle -> "idle",
        .Loading -> "loading",
        .Failed(m) -> "failed ${m}",
        .Ready(n) -> "ready ${n}",
    }
}

fn view() -> column {
    column {
        items: [
            text "left ${words(left.state())}",
            text "right ${words(right.state())}",
            button "Again" { on press { let _ = fetched(left, Request.get("/tasks"), sized) } },
            button "Add" {
                on press {
                    let _ = fetched(
                        added,
                        Request.post("/tasks", Body.Json("{\"title\":\"x\"}")),
                        sized,
                    )
                }
            },
        ]
    }
}

mount(view)
let _ = fetched(left, Request.get("/tasks"), sized)
let _ = fetched(right, Request.get("/tasks"), sized)
