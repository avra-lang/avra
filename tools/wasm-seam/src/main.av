// The M1 host seam: a host row the program declares `extern` crosses as an
// import from `avra:rt`, and an `export fn` leaves the module under its
// written name for the browser bootstrap to call per event. The entry's doors
// are its own exports and those of the module it imports (`near`); `far`'s are
// that module's visibility, so the one nothing reaches is not in the module.

use near.{relayed}

extern fn avra_dom_frame(frame: Bytes)

export fn avra_event(site: int, what: int) {
    avra_dom_frame("seam".bytes())
}

fn main() {
    println(relayed())
}

main()
