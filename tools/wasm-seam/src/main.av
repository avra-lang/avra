// The M1 host seam: a host row the program declares `extern` crosses as an
// import from `avra:rt`, and a HOST FN — an `extern fn` with a body — leaves
// the module under its own name for the browser bootstrap to call per event.
// `near` is the module the entry imports and `far` one it never names: a
// host fn is exported from wherever it is declared, and an `export` is no
// export of the module's.
use near.{relayed}

extern fn avra_dom_frame(frame: Bytes)

extern fn avra_event(site: int, what: int) {
    avra_dom_frame("seam".bytes())
}

fn main() {
    println(relayed())
}

main()
