//! Two instances of a component that keeps state, made by one site with no key: the walk tells
//! them apart by order alone, and says so.
use @std.ui.components.{button, column, text}
use @std.ui.web.{mount}

component tally(label: string) {
    state n: int = 0
    text "${self.label}: ${self.n}"
    button "${self.label}+" { on press { self.n = self.n + 1 } }
}

fn unkeyed(n: string) -> tally { tally "${n}" }

fn view() -> column { column { items: [unkeyed(n) for n in ["x", "y"]] } }

mount(view)
