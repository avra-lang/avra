// a suite's cases, one of them wrong on purpose: the runner's own words for a failing case
use suited.{first, twice}

spec "suited — twice" {
    given "a number" {
        then "it doubles" { twice(2) == 4 }
        then "it doubles a negative" { twice(0 - 3) == 0 - 6 }
        then "this case is wrong on purpose" { twice(2) == 5 }
    }
    then "a lone case, in no group" {
        let xs = [1, 2]
        first(xs) == 1
    }
}
