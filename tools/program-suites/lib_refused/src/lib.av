trait Made {
    static fn made(n: int) -> Self
}

export type Num = { n: int }

impl Made for Num {
    static fn made(n: int) -> Num { Num { n: n } }
}

export type Box = { v: int }

type Inner = { v: int }

impl Inner {
    fn doubled() -> int { self.v * 2 }
}

impl Box {
    fn inner() -> Result<Inner, string> { if self.v < 0 { .Err("negative") } else { .Ok(Inner { v: self.v }) } }

    fn as_made<T: Made>() -> Result<T, string> {
        T.made(self.inner()?.doubled())
    }
}

fn shown(r: Result<Num, string>) -> string {
    match r { .Ok(x) -> "${x.n}", .Err(e) -> e }
}

