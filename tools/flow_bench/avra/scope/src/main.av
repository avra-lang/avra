//! A DEADLINE'S SCOPE, opened and closed around nothing: what `within`
//! itself costs. Prints `within_scope <total ns> <scopes>`.
use @std.io.{env_or}
use @std.text.{parse_int}
use @std.time.{now_ns, secs, within}

fn number(name: string, fallback: int) -> int { parse_int(env_or(name, "")) ?? fallback }

fn scopes(n: int) -> int {
    mut sum = 0
    for i in 0..n { sum = sum + within secs(5) { i } }
    sum
}

let n = number("FLOW_N", 1000000)
let t0 = now_ns()
let sum = scopes(n)
println("within_scope ${now_ns() - t0} ${n}")
