@@ -0,0 +1,41 @@
+//! A SWITCH: two tasks yielding to each other, `FLOW_N` turns each.
+//! Then the same switches while a deadline stands filed: the spawner has
+//! waited once under a `within`. Prints `<key> <total ns> <switches>`.
+use @std.io.{env_or}
+use @std.net.{Bell, bell}
+use @std.text.{parse_int}
+use @std.time.{ms, now_ns, secs, sleep, within}
+
+fn number(name: string, fallback: int) -> int { parse_int(env_or(name, "")) ?? fallback }
+
+fn turns(n: int) -> int {
+    for i in 0..n { sleep(ms(0)) }
+    n
+}
+
+/// The time two tasks take to yield `n` times each.
+fn yielded(n: int) -> int {
+    let t0 = now_ns()
+    let a = spawn turns(n)
+    let b = spawn turns(n)
+    let switches = a.await + b.await
+    if switches == 2 * n { now_ns() - t0 } else { 0 - 1 }
+}
+
+fn held() -> Bell {
+    match bell() { .Ok(b) -> b, .Err(_) -> Bell {} }
+}
+
+/// The same, after one wait under a `within` that stands meanwhile.
+fn yielded_under_within(n: int) -> int {
+    within secs(60) {
+        let b = held()
+        let _ = b.waited(ms(1))
+        b.close()
+        yielded(n)
+    }
+}
+
+let n = number("FLOW_N", 1000000)
+println("yield_switch ${yielded(n)} ${2 * n}")
+println("yield_under_within ${yielded_under_within(n)} ${2 * n}")
diff --git a/tools/flow_bench/go/canceltree/main.go b/tools/flow_bench/go/canceltree/main.go
new file mode 100644
index 0000000..d4a5c3d
--- /dev/null
+++ b/tools/flow_bench/go/canceltree/main.go
@@ -0,0 +1,42 @@
+// Cancel of a tree of tasks: fan-out 10, four levels (11110 tasks),
+// each parked on its own child context; the root is cancelled and
+// every task is joined.
+package main
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"flowbench/internal/row"
+)
+
+func grow(ctx context.Context, depth int, started, done *sync.WaitGroup, count *int) {
+	*count++
+	started.Add(1)
+	done.Add(1)
+	mine, cancel := context.WithCancel(ctx)
+	if depth > 0 {
+		for i := 0; i < 10; i++ {
+			grow(mine, depth-1, started, done, count)
+		}
+	}
+	go func() {
+		started.Done()
+		<-mine.Done()
+		cancel()
+		done.Done()
+	}()
+}
+
+func main() {
+	var started, done sync.WaitGroup
+	root, cancel := context.WithCancel(context.Background())
+	count := 0
+	grow(root, 4, &started, &done, &count)
+	started.Wait()
+	t0 := time.Now()
+	cancel()
+	done.Wait()
+	row.Say("cancel_tree", time.Since(t0).Nanoseconds(), count)
+}
