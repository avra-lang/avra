+    CHECK(read(g_pipe[0], &c, 1) == 1, "the byte is still there");
+    avra_fiber_within_end(outer);
+    CHECK(avra_sched_timers() == 0 && avra_sched_fd_waiters() == 0, "nothing stays filed");
