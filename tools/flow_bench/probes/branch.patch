+static void* claims_when_filed(void* self) {
+    int64_t most = 0;
+    for (int64_t i = 0; i < cap(self);) {
+        if (avra_sched_timers() > most) most = avra_sched_timers();
+        if (avra_gate_claim(g_gate) >= 0) i++;
