+		case <-c[58]:
+		case <-c[59]:
+		case <-c[60]:
+		case <-c[61]:
+		case <-c[62]:
+		case <-c[63]:
+		}
+	}
+	return time.Since(t0).Nanoseconds()
+}
+
+func merged(n, picks int) int64 {
+	c := fed(n, picks)
+	one := make(chan int)
+	for i := range c {
+		go func() {
+			for v := range c[i] {
+				one <- v
+			}
+		}()
+	}
+	t0 := time.Now()
+	for i := 0; i < picks; i++ {
+		<-one
