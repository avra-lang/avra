//! asks: a block that answers nothing
use @std.time.{secs, ms, sleep}
use @std.meta.{Code}
use @std.time.{Duration}

/// What a `within` whose time ran out answers.
type TimedOut = { after: Duration }

fn expired() -> bool { false }

fn timed<T>(after: Duration, v: T) -> Result<T, TimedOut> {
    if expired() { return .Err(TimedOut { after: after }) }
    .Ok(v)
}

/// `within2 limit { … }` — the block's value, or `TimedOut`.
component within2(limit: Code) {
    body: Code
    fn expand() -> Code {
        quote {
            {
                let limit: Duration = ${self.limit}
                let v = ${self.body}
                timed(limit, v)
            }
        }
    }
}

fn waited() -> string {
    let r = within2 ms(50) { sleep(ms(1)) }
    match r { .Ok(_) -> "slept", .Err(t) -> "late" }
}

waited()
