//! asks: a second verb, a cancel verb, and a task that answers nothing
use @std.time.{ms, sleep}

fn work(n: int) -> int { n * 2 }

fn quiet() { sleep(ms(1)) }

fn second() -> int {
    let t = spawn work(2)
    t.cancel()
    match t.joined { .Ok(v) -> v, .Err(c) -> 0 }
}

fn nothing() -> string {
    let t = spawn quiet()
    let r: Result<void, string> = .Ok(t.await)
    "done"
}

println("${second()}")
