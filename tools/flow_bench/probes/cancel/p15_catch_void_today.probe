//! asks: a `catch` whose ok side is nothing, in the one spelling today's types allow — a record error, a statement arm
type Cancelled = { by: int }

fn told(n: int) -> Result<int, Cancelled> {
    if n < 0 { fail Cancelled { by: 7 } }
    .Ok(n)
}

fn seen(n: int) -> string {
    let v = told(n) catch c -> { 0 - c.by }
    "${v}"
}

fn redundant(n: int) -> Result<int, Cancelled> {
    let v = told(n)?
    .Ok(v)
}

println("${seen(1)} ${seen(0 - 1)}")
