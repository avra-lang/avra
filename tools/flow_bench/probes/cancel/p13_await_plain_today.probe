//! asks: what stays true under option C — `.await` is the `T`, a `match` reads the `T`, a task answering nothing is a statement
use @std.time.{ms, sleep}

fn work(n: int) -> int { n * 2 }

fn quiet() { sleep(ms(1)) }

fn matched() -> string {
    let t = spawn work(4)
    match t.await { 8 -> "the T", _ -> "other" }
}

fn nothing() -> string {
    let t = spawn quiet()
    t.await
    "joined"
}

println("${matched()} ${nothing()}")
