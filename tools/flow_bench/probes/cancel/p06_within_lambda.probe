//! asks: the same block as a lambda — what a lifted body loses
use @std.time.{Duration, secs, ms}

type TimedOut = { after: Duration }

fn bounded<T>(after: Duration, body: fn() -> T) -> Result<T, TimedOut> { .Ok(body()) }

fn number(s: string) -> Result<int, string> {
    if s != "4" { fail "not a number" }
    .Ok(4)
}

fn early(n: int) -> int {
    let v = bounded(secs(1)) {
        if n > 1 { return 0 - n }
        n
    } catch _ -> 0
    v * 10
}

fn parsed(s: string) -> Result<int, string> {
    let v = bounded(ms(500)) { number(s)? + 1 } catch _ -> 0
    .Ok(v)
}

println("${early(1)} ${early(3)}")
