//! asks: option C's forms against today's compiler — does `t.await catch` parse, and what each neighbour means
use @std.time.{ms, sleep}

fn work(n: int) -> int { n * 2 }

fn quiet() { sleep(ms(1)) }

fn direct() -> int {
    let t = spawn work(1)
    t.await catch c -> { 0 }
}

fn grouped() -> int {
    let t = spawn work(2)
    (t.await) catch c -> 0
}

fn bound_first() -> int {
    let t = spawn work(3)
    let v = t.await
    v catch c -> 0
}

fn nothing() {
    let t = spawn quiet()
    t.await catch c -> { println("cancelled") }
}

fn matched() -> string {
    let t = spawn work(4)
    match t.await { 8 -> "the T", _ -> "other" }
}

println(matched())
