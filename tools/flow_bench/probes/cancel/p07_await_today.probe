//! asks: `.await` today, and what a `?` or a `catch` on it says
type Cancelled = { by: int }

fn work(n: int) -> int { n * 2 }

fn plain() -> int {
    let t = spawn work(2)
    t.await
}

fn propagated() -> Result<int, Cancelled> {
    let t = spawn work(3)
    let v = t.await?
    .Ok(v)
}

fn caught() -> int {
    let t = spawn work(4)
    t.await catch c -> 0
}

println("${plain()}")
