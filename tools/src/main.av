//! `avra-tools` — the tree's instruments as one program, a command each
//! under `commands/`. This entry composes them and nothing else.
//! Exit 0 clean, 1 refused, 2 usage.

use @std.cli.{cli, argv}
use @std.process.{exit, Exit}
use commands.{pr_mode, ci_path_gate, hooks_released}

cli avra_tools {
    description: "The tree's instruments"
    version: "0.0.1"
    pr_mode
    ci_path_gate
    hooks_released
}
exit(Exit.Code(avra_tools.run()))
