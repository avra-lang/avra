use commands.{pr_mode_of}

spec "pr_mode — a PR's run mode" {
    then "a draft without the label is light" { pr_mode_of("{\"draft\": true, \"labels\": []}") == "light" }
    then "a draft with full-ci is full" { pr_mode_of("{\"draft\": true, \"labels\": [{\"name\": \"full-ci\"}]}") == "full" }
    then "a ready PR is full" { pr_mode_of("{\"draft\": false, \"labels\": []}") == "full" }
    then "a ready PR with full-ci is full" { pr_mode_of("{\"draft\": false, \"labels\": [{\"name\": \"full-ci\"}]}") == "full" }
    then "an empty answer is full" { pr_mode_of("") == "full" }
    then "a blank answer is full" { pr_mode_of("   \n") == "full" }
    then "an unreadable answer is full" { pr_mode_of("not json") == "full" }
    then "an answer that is no object is full" { pr_mode_of("[1]") == "full" }
}
