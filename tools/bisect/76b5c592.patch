 }
 
+/// The key of the item at `at` in `file`, read back as `kind` from two words of what it was read from:
+/// each part folded into both lanes as a word of its own, nothing boxed.
+fn item_key_of(file: SourceFileAddress, at: ItemId, kind: int, first: int, second: int) -> ContentHash {
+    key_of_lanes(
+        item_key_folded(HIGH_LANE, file, at, kind, first, second),
+        item_key_folded(LOW_LANE, file, at, kind, first, second),
+    )
+}
+
+fn item_key_folded(
+    lane: KeyLane,
+    file: SourceFileAddress,
+    at: ItemId,
+    kind: int,
+    first: int,
+    second: int,
+) -> int {
+    let placed = lane
+        .word(lane.word(lane.word(lane.seed, file.key.high_word), file.key.low_word), at.of)
+    lane.word(lane.word(lane.word(placed, kind), first), second)
+}
+
+/// How a written item's key tells it from a made one's.
+const WRITTEN_ITEM: int = 0
+
+/// How a made item's key tells it from a written one's.
+const MADE_ITEM: int = 1
+
 /// The item `key` names, read back from the tape `placed` answers: the one held under the key, else
 /// read and held. `key` names its content — a written item's text, a made one's whole tape — so two
