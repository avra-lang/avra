 impl BodyAt {
-    /// The body as a walk tells it from another.
-    fn key() -> string {
-        let of = if self.of == null { "" } else { spelled_file(self.of!) }
-        "${spelled_file(self.file)} ${self.name} ${self.owner ?? ""} ${of} ${self.statics} ${self.defaulted.word()} ${self.seat_of ?? ""} ${self.given_by ?? ""} ${[f.spelled() for f in self.fills].join(",")} ${self.case_item ?? -1} ${self.case_index}"
+    /// The body as a walk tells it from another: its content key, every field folded into both
+    /// lanes with nothing boxed.
+    fn print() -> ContentHash { key_of_lanes(self.folded(HIGH_LANE), self.folded(LOW_LANE)) }
+
+    /// Every field folded into `lane`, each to one word of its own.
+    fn folded(lane: KeyLane) -> int {
+        let placed = file_folded(lane, file_folded(lane, lane.seed, self.file), self.of)
+        let named = text_folded(lane, text_folded(lane, text_folded(lane, placed, self.name), self.owner), self.seat_of)
+        let marked = lane
+            .word(
+                lane.word(lane.word(text_folded(lane, named, self.given_by), flag(self.external)), flag(self.statics)),
