     let deferrals = [d! for s in store.stmt_ids() for d in [deferral(store, s)] if d != null]
     let fails = [s for s in store.stmt_ids() if fails_here(store, s)]
@@ -259,7 +261,7 @@ fn breaches_made(view: ItemView) -> ItemBreaches {
