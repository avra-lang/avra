#!/bin/sh
# The whole path from new work to main, in five commands:
#
#   sh tools/work new <name>   worktree ../avra-<name> on branch <name>, off main, compiler seeded
#   sh tools/work test         build and test what the branch touches, on Sprites
#   sh tools/work run <cmd>    run any command in this worktree, on a Sprite
#   sh tools/work land         push the branch, open its PR, queue it to merge
#   sh tools/work status       every open PR: checks and queue state
#
# `test`, `run` and `land` run from inside the worktree. Main moves only through
# GitHub's merge queue, which tests each train's combined commit on its own
# runners (.github/workflows/checks.yml); nothing here writes main.
set -eu

tools=$(cd "$(dirname "$0")" && pwd)
repo=$(cd "$tools/.." && pwd)

die() { echo "work: $*" >&2; exit 1; }

# The main checkout, wherever this copy of the script lives.
main_tree() {
    git -C "$repo" worktree list --porcelain | awk '/^worktree /{w=$2} $0=="branch refs/heads/main"{print w}'
}

new() {
    [ $# -eq 1 ] || die "usage: work new <name>"
    name=$1
    main=$(main_tree)
    wt="$(dirname "$main")/avra-$(echo "$name" | tr / -)"
    [ -e "$wt" ] && die "$wt already exists"
    git -C "$main" fetch -q origin main
    git -C "$main" worktree add -q -b "$name" "$wt" origin/main
    mkdir -p "$wt/build"
    for f in avra libavra_runtime.a; do
        [ -f "$main/build/$f" ] && cp "$main/build/$f" "$wt/build/$f"
    done
    echo "$wt"
}

# Packages the branch touches, plus everything that reaches them.
affected() {
    sh "$tools/affected_packages.sh" origin/main HEAD "$PWD" 2>/dev/null
}

test_() {
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "run from inside a worktree"
    git fetch -q origin main
    changed=$(git diff --name-only --diff-filter=d origin/main...HEAD -- '*.av' | tr '\n' ' ')
    set --
    [ -z "$changed" ] || set -- "build/avra fmt --check $changed"
    # Suites ride three Sprite jobs, each building the compiler once.
    pkgs=$(affected)
    for i in 0 1 2; do
        group=$(echo "$pkgs" | awk -v i=$i 'NR % 3 == i' | tr '\n' ' ')
        [ -z "$group" ] || set -- "$@" "make -o avra libs >/dev/null && s=0; for p in $group; do build/avra test packages/\$p || s=1; done; exit \$s"
    done
    lint=$(echo "$pkgs" | tr '\n' ' ')
    set -- "$@" "s=0; for p in $lint; do [ -d packages/\$p/src ] || continue; build/avra check packages/\$p --baseline tools/idioms.baseline || s=1; done; exit \$s"
    AVRA_SP_TREE=$PWD sh "$tools/sp" -p "$@"
}

run() {
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "run from inside a worktree"
    [ $# -gt 0 ] || die "usage: work run <command…>"
    AVRA_SP_TREE=$PWD sh "$tools/sp" "$@"
}

# Queues the branch's PR straight into the merge queue once its own check
# has passed: an entry that rides auto-merge can wait without its train
# ever starting.
queue() {
    sha=$(git rev-parse HEAD)
    for _ in $(seq 60); do
        verdict=$(gh api "repos/{owner}/{repo}/commits/$sha/check-runs" --jq '[.check_runs[] | select(.name == "test") | .conclusion] | first // ""')
        [ -n "$verdict" ] && break
        sleep 5
    done
    [ "$verdict" = success ] || die "the PR's own test check answered '${verdict:-nothing}'; see it on the PR"
    id=$(gh pr list --head "$1" --state open --json id --jq '.[0].id')
    gh api graphql -f query="mutation{enqueuePullRequest(input:{pullRequestId:\"$id\"}){mergeQueueEntry{position}}}" \
        --jq '"queued at position \(.data.enqueuePullRequest.mergeQueueEntry.position)"'
}

land() {
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "run from inside a worktree"
    branch=$(git branch --show-current)
    [ "$branch" != main ] || die "land a branch, never main"
    [ -z "$(git status --porcelain --untracked-files=no)" ] || die "commit or drop your changes first"
    git fetch -q origin main
    git rebase -q origin/main || die "rebase onto main conflicted; resolve, then run land again"
    [ -n "$(git log --format=%h origin/main..HEAD)" ] || die "nothing to land"
    fmt_preflight
    git push -q --force-with-lease -u origin "$branch"
    if [ "$(gh pr list --head "$branch" --state open --json number --jq length)" = 0 ]; then
        gh pr create --base main --head "$branch" \
            --title "$(git log --reverse --format=%s origin/main..HEAD | head -1)" \
            --body "$(git log --reverse --format='- %s' origin/main..HEAD)"
    fi
    queue "$branch"
    gh pr list --head "$branch" --state open --json url --jq '.[0].url'
}

# THE LOCAL FMT PREFLIGHT — the SAME check the train runs, on the SAME
# changed files, with a compiler BUILT FROM THIS BRANCH. A stale standing
# binary is BLIND here: it refuses syntax the branch added and cannot
# report the canonical diff, so it would certify a file the train then
# refuses. `tools/sp` syncs this tree and builds `build/avra` from it, so
# the byte-for-byte instrument is the branch's own.
fmt_preflight() {
    changed=$(git diff --name-only --diff-filter=d origin/main HEAD -- '*.av' | tr '\n' ' ')
    [ -z "$changed" ] && return 0
    echo "work: fmt preflight — the branch's own compiler over the changed .av" >&2
    AVRA_SP_TREE=$PWD sh "$tools/sp" sh tools/fmt_changed.sh --files $changed \
        || die "fmt --check refused the branch's changed .av — the train would too; run: build/avra fmt --write$(echo " $changed")"
}

status() {
    gh pr list --state open --json number,headRefName,title,statusCheckRollup,autoMergeRequest \
        --jq '.[] | "#\(.number)  \(.headRefName)  \(if .autoMergeRequest then "queued" else "open" end)  checks: \([.statusCheckRollup[]?.conclusion // "pending"] | unique | join(","))  \(.title)"'
}

case "${1:-}" in
    new) shift; new "$@" ;;
    test) test_ ;;
    run) shift; run "$@" ;;
    land) land ;;
    status) status ;;
    *) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
