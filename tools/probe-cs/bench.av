fn fill(c: Cell<List<int>>, n: int) {
    for k in 0..100 {
        for i in 0..n { c.set_at(i, i + k) }
    }
}
fn rename(c: Cell<List<string>>, n: int) {
    for k in 0..10 {
        for i in 0..n { c.set_at(i, "s${i}") }
    }
}
let ints = Cell.new([0 for i in 0..10000])
fill(ints, 10000)
let words = Cell.new(["" for i in 0..10000])
rename(words, 10000)
"${ints.get()[9999]} ${words.get()[9999]}"
