// A task recurses past any stack it could have: it must end the run with the
// scheduler's words and a status of 2, never a fall into a neighbour's memory
// and never an engine's bare error.
use @std.time.{ms, sleep}

fn deep(d: int, log: Cell<int>) -> int {
    defer log.set(log.get() + 1)
    if d == 0 {
        sleep(ms(1))
        return 1
    }
    1 + deep(d - 1, log)
}

fn main() {
    let log = Cell.new(0)
    let t = spawn deep(20000000, log)
    println("${t.await} ${log.get()}")
}

main()
