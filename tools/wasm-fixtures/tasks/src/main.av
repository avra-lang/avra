// Tasks on a hosted scheduler: two tasks spawned, each parked on a timer,
// joined in turn. The program's output is the same on every engine.
use @std.time.{ms, sleep}

fn worker(n: int) -> int {
    sleep(ms(5))
    n * 2
}

fn main() {
    let a = spawn worker(10)
    let b = spawn worker(20)
    println("spawned")
    println("${a.await + b.await}")
}

main()
