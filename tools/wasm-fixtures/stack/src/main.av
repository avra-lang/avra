// A task recurses 5000 deep and parks at the bottom: every engine runs it to
// the end and every deferred mark is paid on the way out.
use @std.time.{ms, sleep}

fn deep(d: int, log: Cell<int>) -> int {
    defer log.set(log.get() + 1)
    if d == 0 {
        sleep(ms(1))
        return 1
    }
    1 + deep(d - 1, log)
}

fn main() {
    let log = Cell.new(0)
    let t = spawn deep(5000, log)
    println("${t.await} ${log.get()}")
}

main()
