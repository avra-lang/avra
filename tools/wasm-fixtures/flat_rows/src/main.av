// A settled const list of scalar rows read FLAT, beside a runtime list of
// the same row type: the flat path and the boxed sibling must agree.
type Pair = { a: int, b: int }

const FIRST: List<Pair> = [Pair { a: 1, b: 2 }, Pair { a: 3, b: 4 }]
const SECOND: List<Pair> = [Pair { a: 5, b: 6 }, Pair { a: 7, b: 8 }]

fn base() -> int { 9 }

fn settled_total() -> int {
    mut t = 0
    for row in FIRST { t = t + row.a * 10 + row.b }
    for row in SECOND { t = t + row.a * 10 + row.b }
    t
}

fn live_total() -> int {
    let rows: List<Pair> = [
        Pair { a: base(), b: base() + 1 },
        Pair { a: base() + 2, b: base() + 3 },
    ]
    mut t = 0
    for row in rows { t = t + row.a * 10 + row.b }
    t
}

fn main() {
    println("${settled_total()} ${live_total()}")
}

main()
