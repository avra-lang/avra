#!/bin/sh
# sp — run a command on the idlest free Sprite, against THIS worktree.
#
#   sh tools/sp <cmd...>                 one command, output streamed, its exit status
#   sh tools/sp -p "<cmd1>" "<cmd2>" ... each on its own Sprite at once, lines
#                                        labelled, a summary table, exit 1 on any failure
#
#   sh tools/sp build/avra test packages/std-avrac
#   sh tools/sp -p "build/avra test packages/std-avrac" "build/avra test packages/cli"
#
# The tree syncs by rsync and build/avra comes from the Sprite's compiler cache
# (tools/sprite-build.sh); LLVM_PREFIX is set. Pool: `sprite list` minus
# web-terminal and avra-bench, or AVRA_SPRITES. AVRA_SP_TREE names another tree. Slots per Sprite:
# AVRA_SP_JOBS_PER_SPRITE (default 3). A Sprite that misses its probe is skipped.
# With no slot to be had, a command waits its turn, saying where it stands.
set -eu

here=$(cd "$(dirname "$0")" && pwd)
worktree=$(cd "${AVRA_SP_TREE:-$here/..}" && pwd)
slug=$(basename "$worktree")
jobs=${AVRA_SP_JOBS_PER_SPRITE:-3}
slots=/tmp/avra-sp-slots
llvm=/usr/lib/llvm-22

# The pool: awake Sprites first, and a sleeping one only while the org's
# cap of running Sprites (AVRA_SP_MAX_RUNNING, default 10) has room, since
# waking one past it fails.
pool() {
    if [ -n "${AVRA_SPRITES:-}" ]; then echo "$AVRA_SPRITES"; return 0; fi
    timeout -k 1 15 sprite api /sprites 2>/dev/null | python3 -c '
import json, sys
cap = int(sys.argv[1])
rows = json.load(sys.stdin)["data"]
up = [r["name"] for r in rows if r["status"] == "running"]
mine = lambda n: n not in ("web-terminal", "avra-bench")
names = [n for n in up if mine(n)]
if len(up) < cap:
    names += [r["name"] for r in rows if r["status"] != "running" and mine(r["name"])]
print(" ".join(names))' "${AVRA_SP_MAX_RUNNING:-10}"
}

# The pool, idlest first; a Sprite that did not answer its probe is dropped.
ranked() {
    pool=$(pool)
    probe_log=$(mktemp -t avra-sp-probe.XXXXXX)
    order=$(AVRA_SPRITE_PROBE_S=10 sh "$here/land.sh" --call sprites_by_load $pool 2>"$probe_log")
    dead=$(sed -n 's/^land-linux: \(.*\) did not answer its load probe$/\1/p' "$probe_log")
    rm -f "$probe_log"
    for s in $order; do
        case " $(echo $dead) " in *" $s "*) ;; *) printf '%s ' "$s" ;; esac
    done
}

# A slot is a directory holding its owner's pid; a dead owner's slot is free.
# The tree lock keeps one run per (Sprite, worktree), since both share a tree.
take() {
    d=$1
    mkdir "$d" 2>/dev/null && { echo $$ > "$d/pid"; return 0; }
    p=$(cat "$d/pid" 2>/dev/null || echo)
    [ -n "$p" ] && kill -0 "$p" 2>/dev/null && return 1
    rm -rf "$d"
    mkdir "$d" 2>/dev/null && { echo $$ > "$d/pid"; return 0; }
    return 1
}

# Claims a Sprite from $1 (ranked), avoiding the names in $2 while any other
# has room. Prints "<sprite> <slot dir> <tree dir>".
claim() {
    for avoid in "$2" ""; do
        for s in $1; do
            case " $avoid " in *" $s "*) continue ;; esac
            mkdir -p "$slots/$s"
            take "$slots/$s/tree-$slug" || continue
            n=1
            while [ "$n" -le "$jobs" ]; do
                if take "$slots/$s/slot-$n"; then
                    echo "$s $slots/$s/slot-$n $slots/$s/tree-$slug"
                    return 0
                fi
                n=$((n + 1))
            done
            rm -rf "$slots/$s/tree-$slug"
        done
    done
    return 1
}

alive() { timeout -k 1 5 sprite -s "$1" exec --no-port-forward -- true >/dev/null 2>&1; }

# A waiter's place: a file named by when it began waiting; a dead
# waiter's file does not count.
queue=$slots/.queue
position() {
    n=0
    for f in "$queue"/*; do
        [ -f "$f" ] || continue
        kill -0 "$(cat "$f")" 2>/dev/null || continue
        n=$((n + 1))
        [ "$f" = "$1" ] && break
    done
    echo "$n"
}

# A live claim: a Sprite that fails its liveness probe is released and
# dropped for this run. With no slot anywhere it waits, saying so once and
# then once a minute with its place in the queue.
claim_waiting() {
    mine=
    said=0
    while :; do
        if claimed=$(claim "$1" "$2"); then
            s=${claimed%% *}
            alive "$s" && { [ -z "$mine" ] || rm -f "$mine"; echo "$claimed"; return 0; }
            r=${claimed#* }
            rm -rf "${r%% *}" "${r#* }"
            echo "sp: $s failed its 5s liveness probe — trying the next" >&2
            set -- "$(echo " $1 " | sed "s/ $s / /")" "$2"
            continue
        fi
        if [ -z "$mine" ]; then
            mkdir -p "$queue"
            mine="$queue/$(date +%s)-$$-$(od -An -N2 -tu2 /dev/urandom | tr -d ' ')"
            echo "$$" > "$mine"
            trap 'rm -f "$mine"' EXIT
        fi
        now=$(date +%s)
        if [ $((now - said)) -ge 60 ]; then
            echo "sp: every Sprite slot is taken — waiting, number $(position "$mine") in the queue" >&2
            said=$now
        fi
        sleep 5
    done
}

# Runs one command string on a claimed Sprite; its status is the command's.
run_on() {
    sh "$here/sprite-build.sh" "$1" "$worktree" -- bash -lc "export LLVM_PREFIX=$llvm; $2"
}

[ "$#" -gt 0 ] || { sed -n '2,16p' "$0" >&2; exit 2; }
[ "$1" != --pool ] || { pool; exit 0; }
sprites=$(ranked)
[ -n "$sprites" ] || echo "sp: no Sprite answered its probe" >&2

if [ "$1" != -p ]; then
    set -- "$(for a in "$@"; do printf "'%s' " "$(printf '%s' "$a" | sed "s/'/'\\\\''/g")"; done)"
    cmd=$1
    claimed=$(claim_waiting "$sprites" "")
    sprite=${claimed%% *}; rest=${claimed#* }
    slot=${rest%% *}; tree=${rest#* }
    trap 'rm -rf "${slot:-}" "${tree:-}"' EXIT
    echo "sp: $sprite" >&2
    st=0
    run_on "$sprite" "$cmd" || st=$?
    exit "$st"
fi

shift
out=$(mktemp -d -t avra-sp.XXXXXX)
trap 'rm -rf "$out"' EXIT
used=""
i=0
for cmd in "$@"; do
    i=$((i + 1))
    claimed=$(claim_waiting "$sprites" "$used")
    sprite=${claimed%% *}; rest=${claimed#* }
    slot=${rest%% *}; tree=${rest#* }
    used="$used $sprite"
    printf '%s\n' "$cmd" > "$out/$i.cmd"
    echo "$sprite" > "$out/$i.sprite"
    (
        trap 'rm -rf "$slot" "$tree"' EXIT
        t=$(date +%s)
        { st=0; run_on "$sprite" "$cmd" 2>&1 || st=$?; echo "$st" > "$out/$i.st"; } |
            awk -v p="[$i $sprite] " '{ print p $0; fflush() }'
        echo $(( $(date +%s) - t )) > "$out/$i.s"
    ) &
    runners="${runners:-} $!"
done
n=$i
wait $runners

fail=0
echo
printf '%-3s %-18s %6s %5s  %s\n' '#' sprite seconds exit command
i=0
while [ "$i" -lt "$n" ]; do
    i=$((i + 1))
    st=$(cat "$out/$i.st")
    [ "$st" = 0 ] || fail=1
    printf '%-3s %-18s %6s %5s  %s\n' "$i" "$(cat "$out/$i.sprite")" "$(cat "$out/$i.s")" "$st" "$(cat "$out/$i.cmd")"
done
exit "$fail"
