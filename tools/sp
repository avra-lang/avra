#!/bin/sh
# sp — run a command on a free Sprite, against THIS worktree.
#
#   sh tools/sp <cmd...>                 one command, output streamed, its exit status
#   sh tools/sp -p "<cmd1>" "<cmd2>" ... each on its own Sprite at once, lines
#                                        labelled, a summary table, exit 1 on any failure
#   sh tools/sp --health                 every Sprite and every lease, in seconds; exit 1 if any is unwell
#   sh tools/sp --repair                 reap leases, stop orphaned runs, provision, prune; says what it did
#
#   sh tools/sp build/avra test packages/std-avrac
#   sh tools/sp -p "build/avra test packages/std-avrac" "build/avra test packages/cli"
#
# The tree syncs by rsync and build/avra comes from the Sprite's compiler
# cache (tools/sprite-build.sh); LLVM_PREFIX is set. AVRA_SP_TREE names
# another tree.
#
# THE POOL is `sprite list` minus AVRA_SP_EXCLUDE, or AVRA_SPRITES. It
# takes ONE RUN PER WORKTREE ON A SPRITE — a `-p` batch wants a Sprite a
# command — and AVRA_SP_JOBS_PER_SPRITE (2) runs on one Sprite across
# worktrees, while it has AVRA_SP_MIN_FREE_MB (2500) of memory to give.
#
# A SPRITE SLEEPS WHEN IDLE and wakes in seconds, or in minutes, or not
# at all. One that misses its AVRA_SP_PROBE_S (12) probe is left out for
# AVRA_SP_DEAD_S (120) while a waker goes on asking, and joins the pool
# the moment it answers; nobody waits on it while another has room. One
# that fails a run before its command began is left out the same way,
# and the command moves to another.
#
# WITH NO SLOT TO BE HAD a command waits its turn, first come first
# served per Sprite, saying where it stands — for AVRA_SP_WAIT_S (900),
# then leaves with 75 and the reason.
#
# A LEASE DIES WITH ITS OWNER: slots live under AVRA_SP_SLOTS
# (/tmp/avra-sp-slots), each naming its owner's pid and birth, and every
# caller reaps the ones whose owner is gone. An interrupted sp stops its
# run on the Sprite before it leaves.
#
#   sh tools/sp --pool                           the answering pool, one line
#   sh tools/sp --lease <n> <pid> <sprite...>    a free slot among slots 1..n,
#                                                owned by <pid>: prints its dir
#   sh tools/sp --command <cmd...>               the command a run would assemble
set -eu

here=$(cd "$(dirname "$0")" && pwd)
. "$here/sprite-lib.sh"
worktree=$(cd "${AVRA_SP_TREE:-$here/..}" && pwd)
slug=$(basename "$worktree")
jobs=${AVRA_SP_JOBS_PER_SPRITE:-2}
min_free=${AVRA_SP_MIN_FREE_MB:-2500}
probe_s=${AVRA_SP_PROBE_S:-12}
dead_s=${AVRA_SP_DEAD_S:-120}
wait_s=${AVRA_SP_WAIT_S:-900}
poll_s=${AVRA_SP_POLL_S:-5}
llvm=/usr/lib/llvm-22
queue=$slots/.queue
dead_dir=$slots/.dead
build=${AVRA_SP_BUILD:-$here/sprite-build.sh}
# `web-terminal` and `avra-bench` are not build hosts.
exclude=${AVRA_SP_EXCLUDE:-web-terminal avra-bench}

pool() {
    if [ -n "${AVRA_SPRITES:-}" ]; then echo "$AVRA_SPRITES"; return 0; fi
    timeout -k 1 15 "$sprite_cli" api /sprites 2>/dev/null | python3 -c '
import json, sys
skip = set(sys.argv[1].split())
print(" ".join(r["name"] for r in json.load(sys.stdin)["data"] if r["name"] not in skip))' "$exclude"
}

# A Sprite left out: it missed a probe, or failed a run, within dead_s.
is_dead() {
    at=$(cat "$dead_dir/$1" 2>/dev/null) || return 1
    case $at in '' | *[!0-9]*) return 1 ;; esac
    [ $(($(date +%s) - at)) -lt "$dead_s" ]
}
mark_dead() { mkdir -p "$dead_dir"; date +%s > "$dead_dir/$1"; }
living() { for s in "$@"; do is_dead "$s" || printf '%s ' "$s"; done; }

# One Sprite's "<load> <cores> <free MB>", or nothing within probe_s.
# AVRA_SP_LOAD_PROBE stands in for it.
probe() {
    if [ -n "${AVRA_SP_LOAD_PROBE:-}" ]; then "$AVRA_SP_LOAD_PROBE" "$1"; return; fi
    remote "$1" "$probe_s" status 2>/dev/null | awk -F= '{ v[$1] = $2 } END { if (v["cores"]) print v["load"], v["cores"], v["mem_avail_mb"]; else exit 1 }'
}

# Goes on asking a Sprite that missed its probe, and lifts its mark the
# moment it answers. AVRA_SP_WAKER stands in for it.
waker() {
    if [ -n "${AVRA_SP_WAKER:-}" ]; then "$AVRA_SP_WAKER" "$1"; return; fi
    (woken "$1" 150 status >/dev/null 2>&1 && rm -f "$dead_dir/$1") </dev/null >/dev/null 2>&1 &
}

# The answering pool with memory to give, idlest first.
ranked() {
    d=$(mktemp -d "${TMPDIR:-/tmp}/avra-sp-load.XXXXXX")
    for s in $(living $(pool)); do
        (probe "$s" > "$d/$s" 2>/dev/null || { mark_dead "$s"; waker "$s"; }) &
    done
    wait
    for f in "$d"/*; do
        read -r load cores avail < "$f" 2>/dev/null || continue
        [ -n "$avail" ] && [ "$avail" -ge "$min_free" ] &&
            awk -v s="${f##*/}" -v l="$load" -v c="$cores" -v a="$avail" 'BEGIN { printf "%012.4f %012d %s\n", l / c, 999999999 - a, s }'
    done | sort | awk '{ printf "%s ", $3 }'
    rm -rf "$d"
}

# A waiter's place: a file named by when it began waiting, holding its
# pid and the Sprites it can use. A dead waiter's file is removed on sight.
reap() {
    for f in "$queue"/*; do
        [ -f "$f" ] || continue
        kill -0 "$(sed -n 1p "$f")" 2>/dev/null || rm -f "$f"
    done
}
position() {
    n=0
    for f in "$queue"/*; do
        [ -f "$f" ] || continue
        n=$((n + 1))
        [ "$f" = "$1" ] && break
    done
    echo "$n"
}

# The Sprites among $2.. that no waiter queued ahead of $1 can use (ahead
# of everyone, when $1 is empty).
unwanted() {
    me=$1
    shift
    wanted=" $(for f in "$queue"/*; do
        [ -f "$f" ] || continue
        [ "$f" = "$me" ] && break
        sed -n 2p "$f"
    done | tr '\n' ' ') "
    for s in "$@"; do
        case $wanted in *" $s "*) ;; *) printf '%s ' "$s" ;; esac
    done
}

# Claims a Sprite for this process, avoiding the names in $1: sets
# `claimed` to "<sprite> <slot dir> <tree dir>". It runs in this shell,
# never a substitution, so an interrupt is heard within one round. The
# pool is asked again every round,
# so a Sprite that woke, or freed memory, is seen. With no slot it
# queues, says so once a minute, and gives up after wait_s with 75.
mine=
claim_waiting() {
    began=$(date +%s)
    said=0
    sprites=${AVRA_SP_RANKED:-}
    while :; do
        reap
        leases sweep >/dev/null
        [ -n "$sprites" ] || sprites=$(ranked)
        can=$(living $sprites)
        if claimed=$(leases claim "$$" "$jobs" "$slug" "$(unwanted "$mine" $can)" "$1"); then
            [ -z "$mine" ] || rm -f "$mine"
            mine=
            return 0
        fi
        now=$(date +%s)
        if [ $((now - began)) -ge "$wait_s" ]; then
            [ -z "$mine" ] || rm -f "$mine"
            echo "sp: no Sprite slot in ${wait_s}s — answering with memory to give: ${can:-none}; left out: $(for s in $(pool); do ! is_dead "$s" || printf '%s ' "$s"; done)" >&2
            return 75
        fi
        if [ -z "$mine" ]; then
            mkdir -p "$queue"
            mine="$queue/$now-$$-$(od -An -N2 -tu2 /dev/urandom | tr -d ' ')"
        fi
        draft="$queue/.$(basename "$mine")"
        printf '%s\n%s\n' "$$" "$(echo $can)" > "$draft" && mv "$draft" "$mine"
        if [ $((now - said)) -ge 60 ]; then
            if [ -z "$can" ]; then
                echo "sp: no Sprite answers with memory to give — waiting for one, up to ${wait_s}s" >&2
            else
                echo "sp: every Sprite slot is taken — waiting, number $(position "$mine") in the queue, up to ${wait_s}s" >&2
            fi
            said=$now
        fi
        sleep "$poll_s"
        sprites=
    done
}

# ONE COMMAND STRING, from either ONE command arg (a shell string, run as
# written) or a many-word argv (each word quoted). A single quoted
# multi-word command must NOT become one shell word — `work run "build/avra
# test pkg"` once ran a FILENAME `build/avra test pkg` and died with "No such
# file or directory".
assemble() {
    if [ "$#" -eq 1 ]; then
        printf '%s' "$1"
    else
        printf '%s' "$(for a in "$@"; do printf "'%s' " "$(printf '%s' "$a" | sed "s/'/'\\\\''/g")"; done)"
    fi
}

# One command on a claimed Sprite; its status is the command's. A Sprite
# that fails before the command began is left out and the command moves
# to another; a run whose connection dropped is run once more.
slot=
tree=
child=
verdict=
release() {
    [ -z "$slot" ] || rm -rf "$slot" "$tree"
    slot=
    tree=
}
leave() {
    [ -z "$child" ] || { kill -TERM "$child" 2>/dev/null; wait "$child" 2>/dev/null; } || :
    release
    [ -z "$mine" ] || rm -f "$mine" "$queue/.$(basename "$mine")"
    [ -z "$verdict" ] || rm -f "$verdict"
}
one() {
    cmd=$1
    verdict=$(mktemp "${TMPDIR:-/tmp}/avra-sp-verdict.XXXXXX")
    trap leave EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    tries=0
    failed=
    while :; do
        tries=$((tries + 1))
        claim_waiting "$failed" || return $?
        sprite=${claimed%% *}
        rest=${claimed#* }
        slot=${rest%% *}
        tree=${rest#* }
        echo "sp: $sprite" >&2
        : > "$verdict"
        AVRA_SB_VERDICT=$verdict sh "$build" "$sprite" "$worktree" -- bash -lc "export LLVM_PREFIX=$llvm; $cmd" &
        child=$!
        st=0
        wait "$child" || st=$?
        child=
        release
        case "$(cat "$verdict")" in
            unreached) mark_dead "$sprite"; waker "$sprite"; failed="$failed $sprite" ;;
            dropped) [ "$tries" -lt 2 ] || return "$st" ;;
            *) return "$st" ;;
        esac
        [ "$tries" -lt 4 ] || return "$st"
        echo "sp: $sprite did not finish the run — taking another Sprite" >&2
        unset AVRA_SP_RANKED
    done
}

# Every command at once, each its own sp; an interrupt reaches them all.
many() {
    out=$(mktemp -d "${TMPDIR:-/tmp}/avra-sp.XXXXXX")
    kids=
    trap 'for k in $kids; do kill -TERM "$k" 2>/dev/null || :; done; wait; rm -rf "$out"' EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    AVRA_SP_RANKED=$(ranked)
    export AVRA_SP_RANKED
    [ -n "$AVRA_SP_RANKED" ] || echo "sp: no Sprite answered its probe yet" >&2
    i=0
    for cmd in "$@"; do
        i=$((i + 1))
        printf '%s\n' "$cmd" > "$out/$i.cmd"
        mkfifo "$out/$i.lines"
        awk -v p="[$i] " '{ print p $0; fflush() }' < "$out/$i.lines" &
        AVRA_SP_REPORT="$out/$i" sh "$0" "$cmd" > "$out/$i.lines" 2>&1 &
        kids="$kids $!"
    done
    wait
    kids=
    fail=0
    echo
    printf '%-3s %-18s %7s %5s  %s\n' '#' sprite seconds exit command
    n=0
    while [ "$n" -lt "$i" ]; do
        n=$((n + 1))
        read -r st secs on < "$out/$n" 2>/dev/null || { st="?"; secs="?"; on=-; }
        [ "$st" = 0 ] || fail=1
        printf '%-3s %-18s %7s %5s  %s\n' "$n" "${on:--}" "$secs" "$st" "$(cat "$out/$n.cmd")"
    done
    return "$fail"
}

[ "$#" -gt 0 ] || { sed -n '2,40p' "$0" >&2; exit 2; }
case $1 in
    --pool) echo $(ranked); exit 0 ;;
    --lease)
        shift
        max=$1 owner=$2
        shift 2
        reap
        leases sweep >/dev/null
        leases lease "$max" "$owner" $(unwanted "" $(living "$@"))
        exit $?
        ;;
    # Needs no Sprite — the seam `tools/witness_work_run.sh` holds the two forms to one another.
    --command) shift; assemble "$@"; echo; exit 0 ;;
    --health | --repair) . "$here/sprite-health.sh"; exit $? ;;
    -p) shift; many "$@"; exit $? ;;
esac
t0=$(date +%s)
st=0
one "$(assemble "$@")" || st=$?
# A `-p` batch's row for this command.
[ -z "${AVRA_SP_REPORT:-}" ] || echo "$st $(($(date +%s) - t0)) ${sprite:--}" > "$AVRA_SP_REPORT"
exit "$st"
