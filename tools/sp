#!/bin/sh
# sp — run a command on the idlest free Sprite, against THIS worktree.
#
#   sh tools/sp <cmd...>                 one command, output streamed, its exit status
#   sh tools/sp -p "<cmd1>" "<cmd2>" ... each on its own Sprite at once, lines
#                                        labelled, a summary table, exit 1 on any failure
#
#   sh tools/sp build/avra test packages/std-avrac
#   sh tools/sp -p "build/avra test packages/std-avrac" "build/avra test packages/cli"
#
# The tree syncs by rsync and build/avra comes from the Sprite's compiler cache
# (tools/sprite-build.sh); LLVM_PREFIX is set. Pool: `sprite list` minus
# web-terminal and avra-bench, or AVRA_SPRITES. AVRA_SP_TREE names another tree. Slots per Sprite:
# AVRA_SP_JOBS_PER_SPRITE (default 3). A Sprite that misses its probe is skipped.
# With no slot to be had, a command waits its turn, saying where it stands.
#
#   sh tools/sp --pool                           the living pool, one line
#   sh tools/sp --lease <n> <pid> <sprite...>    a free slot among slots 1..n,
#                                                owned by <pid>: prints its dir
#
# Slots live under AVRA_SP_SLOTS (default /tmp/avra-sp-slots), shared by
# every caller, so two callers' leases and sp jobs
# never oversubscribe one Sprite. Waiters queue first come, first served
# PER SPRITE: a free slot goes to the earliest waiter that can use it,
# so a waiter pinned elsewhere blocks nobody. A Sprite that fails its
# liveness probe is skipped by every caller for AVRA_SP_DEAD_S (300).
set -eu

here=$(cd "$(dirname "$0")" && pwd)
worktree=$(cd "${AVRA_SP_TREE:-$here/..}" && pwd)
slug=$(basename "$worktree")
jobs=${AVRA_SP_JOBS_PER_SPRITE:-3}
slots=${AVRA_SP_SLOTS:-/tmp/avra-sp-slots}
llvm=/usr/lib/llvm-22
queue=$slots/.queue
dead_dir=$slots/.dead
dead_s=${AVRA_SP_DEAD_S:-300}
build=${AVRA_SP_BUILD:-$here/sprite-build.sh}

# The pool: awake Sprites first, and a sleeping one only while the org's
# cap of running Sprites (AVRA_SP_MAX_RUNNING, default 10) has room, since
# waking one past it fails.
pool() {
    if [ -n "${AVRA_SPRITES:-}" ]; then echo "$AVRA_SPRITES"; return 0; fi
    timeout -k 1 15 sprite api /sprites 2>/dev/null | python3 -c '
import json, sys
cap = int(sys.argv[1])
rows = json.load(sys.stdin)["data"]
up = [r["name"] for r in rows if r["status"] == "running"]
mine = lambda n: n not in ("web-terminal", "avra-bench")
names = [n for n in up if mine(n)]
if len(up) < cap:
    names += [r["name"] for r in rows if r["status"] != "running" and mine(r["name"])]
print(" ".join(names))' "${AVRA_SP_MAX_RUNNING:-10}"
}

# A Sprite that failed its liveness probe within the last dead_s seconds.
is_dead() {
    at=$(cat "$dead_dir/$1" 2>/dev/null) || return 1
    case $at in '' | *[!0-9]*) return 1 ;; esac
    [ $(( $(date +%s) - at )) -lt "$dead_s" ]
}
mark_dead() { mkdir -p "$dead_dir"; date +%s > "$dead_dir/$1"; }
living() { for s in "$@"; do is_dead "$s" || printf '%s ' "$s"; done; }

# One Sprite's load, cores and free MB, or nothing within 10 s.
# AVRA_SP_LOAD_PROBE stands in for it.
probe() {
    if [ -n "${AVRA_SP_LOAD_PROBE:-}" ]; then "$AVRA_SP_LOAD_PROBE" "$1"; return; fi
    timeout -k 1 10 sprite exec -s "$1" -- sh -c 'set -- $(cat /proc/loadavg); echo "$1 $(nproc) $(awk "/^MemAvailable:/ { print int(\$2 / 1024) }" /proc/meminfo)"' 2>/dev/null
}

# The pool, idlest first; a Sprite that did not answer its probe is dropped.
ranked() {
    d=$(mktemp -d "${TMPDIR:-/tmp}/avra-sp-load.XXXXXX")
    for s in $(living $(pool)); do (probe "$s" > "$d/$s" || :) & done
    wait
    for f in "$d"/*; do
        read -r load cores avail < "$f" 2>/dev/null || continue
        [ -n "$avail" ] && awk -v s="${f##*/}" -v l="$load" -v c="$cores" -v a="$avail" 'BEGIN { printf "%012.4f %012d %s\n", l / c, 999999999 - a, s }'
    done | sort | awk '{ printf "%s ", $3 }'
    rm -rf "$d"
}

# A slot is a directory holding its owner's pid (this process, or $2); a
# dead owner's slot is free. The tree lock keeps one run per (Sprite,
# worktree), since both share a tree.
take() {
    d=$1
    o=${2:-$$}
    mkdir "$d" 2>/dev/null && { echo "$o" > "$d/pid"; return 0; }
    p=$(cat "$d/pid" 2>/dev/null || echo)
    [ -n "$p" ] && kill -0 "$p" 2>/dev/null && return 1
    rm -rf "$d"
    mkdir "$d" 2>/dev/null && { echo "$o" > "$d/pid"; return 0; }
    return 1
}

# A lease for another process: slot level by level across the living
# Sprites in their given order that no queued waiter wants, so work
# spreads before it stacks. Prints the slot dir.
lease() {
    max=$1 owner=$2
    shift 2
    reap
    set -- $(unwanted "" $(living "$@"))
    n=1
    while [ "$n" -le "$max" ]; do
        for s in "$@"; do
            mkdir -p "$slots/$s"
            take "$slots/$s/slot-$n" "$owner" && { echo "$slots/$s/slot-$n"; return 0; }
        done
        n=$((n + 1))
    done
    return 1
}

# Claims a Sprite from $1 (ranked), avoiding the names in $2 while any other
# has room. Prints "<sprite> <slot dir> <tree dir>".
claim() {
    for avoid in "$2" ""; do
        for s in $1; do
            case " $avoid " in *" $s "*) continue ;; esac
            mkdir -p "$slots/$s"
            take "$slots/$s/tree-$slug" || continue
            n=1
            while [ "$n" -le "$jobs" ]; do
                if take "$slots/$s/slot-$n"; then
                    echo "$s $slots/$s/slot-$n $slots/$s/tree-$slug"
                    return 0
                fi
                n=$((n + 1))
            done
            rm -rf "$slots/$s/tree-$slug"
        done
    done
    return 1
}

probe_alive() { timeout -k 1 5 sprite -s "$1" exec --no-port-forward -- true >/dev/null 2>&1; }
alive() {
    "${AVRA_SP_ALIVE:-probe_alive}" "$1" && return 0
    mark_dead "$1"
    return 1
}

# A waiter's place: a file named by when it began waiting, holding its
# pid and the Sprites it can use. A dead waiter's file is removed on sight.
reap() {
    for f in "$queue"/*; do
        [ -f "$f" ] || continue
        kill -0 "$(sed -n 1p "$f")" 2>/dev/null || rm -f "$f"
    done
}
position() {
    n=0
    for f in "$queue"/*; do
        [ -f "$f" ] || continue
        n=$((n + 1))
        [ "$f" = "$1" ] && break
    done
    echo "$n"
}

# The Sprites among $2.. that no waiter queued ahead of $1 can use (ahead
# of everyone, when $1 is empty).
unwanted() {
    me=$1
    shift
    wanted=" $(for f in "$queue"/*; do
        [ -f "$f" ] || continue
        [ "$f" = "$me" ] && break
        sed -n 2p "$f"
    done | tr '\n' ' ') "
    for s in "$@"; do
        case $wanted in *" $s "*) ;; *) printf '%s ' "$s" ;; esac
    done
}

# The Sprites among $@ whose tree for this worktree is free.
usable() {
    for s in "$@"; do
        p=$(cat "$slots/$s/tree-$slug/pid" 2>/dev/null || echo)
        [ -n "$p" ] && kill -0 "$p" 2>/dev/null && continue
        printf '%s ' "$s"
    done
}

# A live claim: a Sprite that fails its liveness probe is released and
# marked dead for everyone. With no slot to be had it queues, saying so
# once and then once a minute with its place in the queue.
claim_waiting() {
    mine=
    said=0
    while :; do
        kill -0 $$ 2>/dev/null || exit 1
        reap
        can=$(usable $(living $1))
        if claimed=$(claim "$(unwanted "$mine" $can)" "$2"); then
            s=${claimed%% *}
            alive "$s" && { [ -z "$mine" ] || rm -f "$mine"; echo "$claimed"; return 0; }
            r=${claimed#* }
            rm -rf "${r%% *}" "${r#* }"
            echo "sp: $s failed its 5s liveness probe — skipped by everyone for ${dead_s}s" >&2
            set -- "$(echo " $1 " | sed "s/ $s / /")" "$2"
            continue
        fi
        if [ -z "$mine" ]; then
            mkdir -p "$queue"
            mine="$queue/$(date +%s)-$$-$(od -An -N2 -tu2 /dev/urandom | tr -d ' ')"
            draft="$queue/.$(basename "$mine")"
            trap 'rm -f "$mine" "$draft"' EXIT
        fi
        printf '%s\n%s\n' "$$" "$(echo $can)" > "$draft" && mv "$draft" "$mine"
        now=$(date +%s)
        if [ $((now - said)) -ge 60 ]; then
            echo "sp: every Sprite slot is taken — waiting, number $(position "$mine") in the queue" >&2
            said=$now
        fi
        sleep 5
    done
}

# Runs one command string on a claimed Sprite; its status is the command's.
run_on() {
    sh "$build" "$1" "$worktree" -- bash -lc "export LLVM_PREFIX=$llvm; $2"
}

# ONE COMMAND STRING, from either ONE command arg (a shell string, run as
# written) or a many-word argv (each word quoted). A single quoted
# multi-word command must NOT become one shell word — `work run "build/avra
# test pkg"` once ran a FILENAME `build/avra test pkg` and died with "No such
# file or directory".
assemble() {
    if [ "$#" -eq 1 ]; then
        printf '%s' "$1"
    else
        printf '%s' "$(for a in "$@"; do printf "'%s' " "$(printf '%s' "$a" | sed "s/'/'\\\\''/g")"; done)"
    fi
}

[ "$#" -gt 0 ] || { sed -n '2,26p' "$0" >&2; exit 2; }
[ "$1" != --pool ] || { echo $(living $(pool)); exit 0; }
[ "$1" != --lease ] || { shift; lease "$@"; exit $?; }
# `--command` prints the command a run would assemble, and needs no Sprite —
# the seam `tools/witness_work_run.sh` holds the two forms to one another.
[ "$1" != --command ] || { shift; assemble "$@"; echo; exit 0; }
sprites=$(ranked)
[ -n "$sprites" ] || echo "sp: no Sprite answered its probe" >&2

if [ "$1" != -p ]; then
    cmd=$(assemble "$@")
    claimed=$(claim_waiting "$sprites" "")
    sprite=${claimed%% *}; rest=${claimed#* }
    slot=${rest%% *}; tree=${rest#* }
    trap 'rm -rf "${slot:-}" "${tree:-}"' EXIT
    echo "sp: $sprite" >&2
    st=0
    run_on "$sprite" "$cmd" || st=$?
    exit "$st"
fi

shift
out=$(mktemp -d -t avra-sp.XXXXXX)
trap 'rm -rf "$out"' EXIT
used=""
i=0
for cmd in "$@"; do
    i=$((i + 1))
    claimed=$(claim_waiting "$sprites" "$used")
    sprite=${claimed%% *}; rest=${claimed#* }
    slot=${rest%% *}; tree=${rest#* }
    used="$used $sprite"
    printf '%s\n' "$cmd" > "$out/$i.cmd"
    echo "$sprite" > "$out/$i.sprite"
    (
        trap 'rm -rf "${slot:-}" "${tree:-}"' EXIT
        t=$(date +%s)
        { st=0; run_on "$sprite" "$cmd" 2>&1 || st=$?; echo "$st" > "$out/$i.st"; } |
            awk -v p="[$i $sprite] " '{ print p $0; fflush() }'
        echo $(( $(date +%s) - t )) > "$out/$i.s"
    ) &
    runners="${runners:-} $!"
done
n=$i
wait $runners

fail=0
echo
printf '%-3s %-18s %6s %5s  %s\n' '#' sprite seconds exit command
i=0
while [ "$i" -lt "$n" ]; do
    i=$((i + 1))
    st=$(cat "$out/$i.st")
    [ "$st" = 0 ] || fail=1
    printf '%-3s %-18s %6s %5s  %s\n' "$i" "$(cat "$out/$i.sprite")" "$(cat "$out/$i.s")" "$st" "$(cat "$out/$i.cmd")"
done
exit "$fail"
