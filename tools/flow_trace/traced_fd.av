// A wait on a descriptor beside a spawned task, traced alike by both
// engines (tools/flow_trace_engines.sh). The descriptor is the standard
// input, which the keeper fills — so this is no program test: a suite's
// own input is not a program's to wait on.
use @std.time.{ms, sleep}

extern fn avra_wait_fd(fd: int, writable: int, arm: int, member: int)
extern fn avra_wait_park() -> int

fn slept(wait: int) -> int {
    sleep(ms(wait))
    wait
}

let t = spawn slept(2)
avra_wait_fd(0, 0, 1, 2)
let claim = avra_wait_park()
"${claim >> 32}:${claim & 4294967295} ${t.await}"
