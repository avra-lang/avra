//! A Map's cost per key over ORDINARY text keys: inserts into an empty
//! map, then hits, then misses, each timed alone over the same keys.
//! Five rounds, so a noisy machine shows as spread rather than as a
//! number.
use @std.time.{now_ns}

/// Every key once, into a fresh map; the length is read so the work
/// cannot be dropped.
fn inserted(keys: List<string>) -> Map<string, int> {
    mut m: Map<string, int> = {}
    // LICENSED loops.push_loop: a timed loop writes a map, it does not build a list
    for i, k in keys { m.set(k, i) }
    m
}

/// How many of `keys` the map holds.
fn hits(m: Map<string, int>, keys: List<string>) -> int {
    mut found = 0
    // LICENSED loops.push_loop: a timed loop counts, it does not build a list
    for k in keys { found = found + (m.get(k) ?? 0) }
    found
}

fn per_key(ns: int, n: int) -> string { "${ns / n} ns/key" }

fn round(n: int) {
    let keys = ["user:${i}:session" for i in 0..n]
    let absent = ["user:${i}:missing" for i in 0..n]
    let t0 = now_ns()
    let m = inserted(keys)
    let t1 = now_ns()
    let hit = hits(m, keys)
    let t2 = now_ns()
    let miss = hits(m, absent)
    let t3 = now_ns()
    println(
        "${n} keys: insert ${per_key(t1 - t0, n)}  hit ${per_key(t2 - t1, n)}  miss ${per_key(t3 - t2, n)}  (sum ${hit + miss + m.length})",
    )
}

// LICENSED loops.push_loop: rounds print, they build nothing
for _r in 0..5 { round(10000) }
// LICENSED loops.push_loop: rounds print, they build nothing
for _r in 0..5 { round(1000000) }
