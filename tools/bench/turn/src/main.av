//! A server task and a client on the main task, one keep-alive
//! connection, round trips timed: the deterministic instrument — each
//! trip is a write, the server's read, handler and write, and the
//! client's read, with a task switch at every wait.
use @std.net.{Conn, NetError, listen, connect}
use @std.time.{secs, now_ns}
use @std.http.frame.{limits}
use @std.http.http.{text}
use @std.http.server.{Timing, served}

type App = { name: string }

/// One request written and its reply read.
fn turned(c: Conn, req: Bytes) -> Result<int, NetError> {
    let _ = c.write(req)?
    let got = c.read(4096)?
    .Ok(got?.length ?? -1)
}

fn measured(n: int) -> Result<string, NetError> {
    let l = listen("127.0.0.1", 0)?
    let s = served(l, () -> App { name: "turn" }, limits(), Timing { requests: 1000000 }) { app, q -> text(200, "hello") }
    spawn s.run(cores: 1)
    defer s.stop()
    let c = connect("127.0.0.1", l.port, secs(2))?
    defer { let _ = c.close() }
    let req = "GET / HTTP/1.1\r\nHost: bench\r\nUser-Agent: turn\r\nAccept: */*\r\n\r\n".bytes()
    let _ = turned(c, req)?
    let start = now_ns()
    mut i = 0
    while i < n {
        let _ = turned(c, req)?
        i = i + 1
    }
    let each = (now_ns() - start) / n
    .Ok("${n} requests, ${each} ns each round trip")
}

match measured(200000) {
    .Ok(t) -> t,
    .Err(e) -> "failed: ${e.describe().message}",
}
