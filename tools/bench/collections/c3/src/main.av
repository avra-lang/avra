//! C3: map 10M ints to a new list as the source dies — the case reuse
//! in place writes into the source's own buffer.
//! Today: a comprehension over a dying local. Target: `xs.map(f)`.
use @bench.input.{SEED, fold_all, ints, report}
use @std.time.{now_ns}

let xs = ints(SEED, 10000000, 1048576)
let t0 = now_ns()
let ys = [x * 2 + 1 for x in xs]
let t1 = now_ns()
report("C3", fold_all(ys), t0, t1)
