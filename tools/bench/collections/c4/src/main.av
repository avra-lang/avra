//! C4: each of 1M ints to four, flattened.
//! Today: a nested comprehension over a list literal. Target:
//! `xs.flat_map(x -> [x, x + 1, x * 2, x ^ 5])`.
use @bench.input.{SEED, fold_all, ints, report}
use @std.time.{now_ns}

let xs = ints(SEED, 1000000, 1048576)
let t0 = now_ns()
let ys = [y for x in xs for y in [x, x + 1, x * 2, x ^ 5]]
let t1 = now_ns()
report("C4", fold_all(ys), t0, t1)
