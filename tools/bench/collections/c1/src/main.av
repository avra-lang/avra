//! C1: keep the multiples of three, double them, sum — 10M ints.
//! Today: a comprehension, then a loop. Target: `xs.filter(p).map(f).sum()`.
use @bench.input.{SEED, ints, report}
use @std.time.{now_ns}

let xs = ints(SEED, 10000000, 1048576)
let t0 = now_ns()
mut sum = 0
// LICENSED loops.push_loop: the sum today's vocabulary cannot state
for v in [x * 2 for x in xs if x % 3 == 0] { sum = sum + v }
report("C1", sum, t0, now_ns())
