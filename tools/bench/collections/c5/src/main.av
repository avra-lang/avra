//! C5: sort 1M ints in four orders — random, already sorted, reversed,
//! few unique values.
//! Today: core's `sorted_by`, a merge sort over slices, with a
//! comparator. Target: `xs.sorted()`.
use @bench.input.{SEED, fold_all, ints, report}
use @std.avrac.core.{sorted_by}
use @std.time.{now_ns}

fn before(a: int, b: int) -> bool { a < b }

/// One timed sort of `xs`, reported as `row`.
fn sort_row(row: string, xs: List<int>) {
    let t0 = now_ns()
    let ys = sorted_by(xs, before)
    let t1 = now_ns()
    report(row, fold_all(ys), t0, t1)
}

let n = 1000000
sort_row("C5r", ints(SEED, n, 1073741824))
sort_row("C5s", [i for i in 0..n])
sort_row("C5v", [n - i for i in 0..n])
sort_row("C5u", ints(SEED, n, 16))
