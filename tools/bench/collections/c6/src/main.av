//! C6: sort 200k strings in byte order.
//! Today: core's `sorted_by` with core's `text_before`. Target:
//! `xs.sorted()`.
use @bench.input.{SEED, draw, fold_texts, report}
use @std.avrac.core.{sorted_by, text_before}
use @std.time.{now_ns}

let xs = ["${draw(SEED, i) % 1000000000}x${draw(SEED + 1, i) % 10000}" for i in 0..200000]
let t0 = now_ns()
let ys = sorted_by(xs, text_before)
let t1 = now_ns()
report("C6", fold_texts(ys), t0, t1)
