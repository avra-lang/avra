//! C11: join 1M short texts with a separator.
//! Today: `List.join`. Target: unchanged.
use @bench.input.{SEED, draw, folded, report}
use @std.time.{now_ns}

let xs = ["${draw(SEED, i) % 100000}" for i in 0..1000000]
let t0 = now_ns()
let s = xs.join(",")
let t1 = now_ns()
report(
    "C11",
    folded(folded(s.length, s.char_code(s.length / 2)), s.char_code(s.length - 1)),
    t0,
    t1,
)
