//! C2: map 10M ints to a new list while the source stays alive.
//! Today: a comprehension. Target: `xs.map(f)`.
use @bench.input.{SEED, folded, fold_all, ints, report}
use @std.time.{now_ns}

let xs = ints(SEED, 10000000, 1048576)
let t0 = now_ns()
let ys = [x * 2 + 1 for x in xs]
let t1 = now_ns()
report("C2", folded(fold_all(ys), xs.length), t0, t1)
