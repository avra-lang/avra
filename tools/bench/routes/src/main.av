fn asked(line: string) -> Request<Unrouted> {
    let raw = (line + "\r\nHost: h\r\n\r\n").bytes()
    match framed(raw, 0, 0, limits()) {
        .Complete(head) -> Request { raw: raw, head: head, body: Body.Empty, peer: "b", params: Unrouted {} },
        .Partial -> asked(line),
        .Refused(_) -> asked(line),
    }
}
/// THE REFERENCE THE TABLE IS MEASURED AGAINST — a scan down the
/// declared list, trying every route of the right method and width.
/// It lives here rather than in the library because the library
/// ships ONE dispatch door, and this is the algorithm that door had
/// to beat. The widths are precomputed, as a hand-written scan would
/// do, so the comparison is against the fast form of the naive way.
fn scan(rows: List<Route>, widths: List<int>, q: Request<Unrouted>) -> Response {
    let target = q.raw.slice(q.head.target.lo, q.head.target.hi)
    let width = segments(target)
    // LICENSED loops.push_loop: a scan stops at its first answer
    for j, r in rows {
        if r.method == q.head.method && widths[j] == width {
            let answer: Response? = r.serve(q, target)
            if answer != null { return answer! }
        }
    }
    status(404)
}

fn scanned(rows: List<Route>, widths: List<int>, q: Request<Unrouted>, runs: int) -> int {
    mut ok = 0
    // LICENSED loops.push_loop: a timed loop counts, it does not build a list
    for i in 0..runs {
        if scan(rows, widths, q).status == 200 { ok = ok + 1 }
    }
    ok
}

fn tabled(t: Table, q: Request<Unrouted>, runs: int) -> int {
    mut ok = 0
    // LICENSED loops.push_loop: a timed loop counts, it does not build a list
    for i in 0..runs {
        if dispatch(t, q).status == 200 { ok = ok + 1 }
    }
    ok
}

/// Nanoseconds per scan, or -1 when a run did not answer 200 — so a
/// table that never matched cannot read as a fast one.
fn scan_cost(rows: List<Route>, line: string, runs: int) -> int {
    let q = asked(line)
    let widths = [segments(r.pattern.bytes()) for r in rows]
    let start = now_ns()
    let ok = scanned(rows, widths, q, runs)
    let spent = now_ns() - start
    if ok != runs { return 0 - 1 }
    spent / runs
}

/// Nanoseconds per dispatch through the compiled table. The compile
/// is OUTSIDE the clock, which is the whole point of a `once fn`.
fn table_cost(rows: List<Route>, line: string, runs: int) -> int {
    let q = asked(line)
    let t = compiled(rows)
    let start = now_ns()
    let ok = tabled(t, q, runs)
    let spent = now_ns() - start
    if ok != runs { return 0 - 1 }
    spent / runs
}

/// What compiling the table costs, once, in nanoseconds.
fn compile_cost(rows: List<Route>) -> int {
    let start = now_ns()
    let t = compiled(rows)
    now_ns() - start - 0 * t.nodes.length
}

let runs = 50000
let flat = all_flat()
let deep = all_deep()
let wild = all_wild()
let scan3 = scan_cost(flat.slice(297, 300), "GET /lima18/7 HTTP/1.1", runs)
let tab3 = table_cost(flat.slice(297, 300), "GET /lima18/7 HTTP/1.1", runs)
let scan30 = scan_cost(flat.slice(270, 300), "GET /lima18/7 HTTP/1.1", runs)
let tab30 = table_cost(flat.slice(270, 300), "GET /lima18/7 HTTP/1.1", runs)
let scan300 = scan_cost(flat.slice(0, 300), "GET /lima18/7 HTTP/1.1", runs)
let tab300 = table_cost(flat.slice(0, 300), "GET /lima18/7 HTTP/1.1", runs)
let scan_deep = scan_cost(deep, "GET /api/v1/lima18/7 HTTP/1.1", runs)
let tab_deep = table_cost(deep, "GET /api/v1/lima18/7 HTTP/1.1", runs)
let scan_wild = scan_cost(wild, "GET /acme/lima18/7 HTTP/1.1", runs)
let tab_wild = table_cost(wild, "GET /acme/lima18/7 HTTP/1.1", runs)
let build300 = compile_cost(flat)
"runs ${runs} | flat 3: scan ${scan3} table ${tab3} | flat 30: scan ${scan30} table ${tab30} | flat 300: scan ${scan300} table ${tab300} | deep 300: scan ${scan_deep} table ${tab_deep} | wild 300: scan ${scan_wild} table ${tab_wild} | compile 300 ${build300} ns"
