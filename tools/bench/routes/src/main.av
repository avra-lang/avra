fn asked(line: string) -> Request {
    let raw = (line + "\r\nHost: h\r\n\r\n").bytes()
    match framed(raw, 0, 0, limits()) {
        .Complete(head) -> Request { raw: raw, head: head, body: "".bytes(), peer: "b" },
        .Partial -> asked(line),
        .Refused(_) -> asked(line),
    }
}

fn scanned(rows: List<Route>, q: Request, runs: int) -> int {
    mut ok = 0
    // LICENSED I3: a timed loop counts, it does not build a list
    for i in 0..runs {
        if dispatch(rows, q).status == 200 { ok = ok + 1 }
    }
    ok
}

/// Nanoseconds per dispatch, or -1 when a run did not answer 200 —
/// so a table that never matched cannot read as a fast one.
fn cost(rows: List<Route>, line: string, runs: int) -> int {
    let q = asked(line)
    let start = now_ns()
    let ok = scanned(rows, q, runs)
    let spent = now_ns() - start
    if ok != runs { return 0 - 1 }
    spent / runs
}

let runs = 50000
let every = all()
let target = "GET /lima18/7 HTTP/1.1"
let at3 = cost(every.slice(297, 300), target, runs)
let at30 = cost(every.slice(270, 300), target, runs)
let at300 = cost(every.slice(0, 300), target, runs)
"runs ${runs}, hitting the LAST route | 3 routes ${at3} ns | 30 routes ${at30} ns | 300 routes ${at300} ns"
