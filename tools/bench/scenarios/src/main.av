//! The public benchmark's server: `/plaintext`, `/json` and `/db`, the
//! TechEmpower shapes, on `PORT` (default 18080) across `CORES`
//! processes (default 1). `/json` serializes its object per request;
//! `/db` reads one row of a 10,000-row `world` table in each core's own
//! in-memory SQLite.
use @std.net.{NetError, listen}
use @std.http.frame.{limits}
use @std.http.http.{Header, Request, Response, Unrouted, status, text}
use @std.http.server.{served, Timing}
use @std.json.{Json, field, to_text}
use @std.sqlite.{Db, SqlError, SqlValue, sql}
use @std.io.{env_or}
use @std.text.{parse_int}

/// A core's world table, absent when it could not be built, and the
/// generator that picks its rows.
type App = { db: Db?, seed: Cell<int> }

impl App {
    /// The next row id, 1 to 10,000: a Park-Miller step.
    fn next_id() -> int {
        self.seed.set(self.seed.get() * 48271 % 2147483647)
        self.seed.get() % 10000 + 1
    }
}

/// TechEmpower's `World`: ids 1 to 10,000, each with a number from 1
/// to 10,000.
const world_script: string = """
    create table world (id integer primary key, randomNumber integer not null);
    with recursive n(i) as (select 1 union all select i + 1 from n where i < 10000)
    insert into world select i, i * 7919 % 10000 + 1 from n;
"""

fn world() -> Result<Db, SqlError> {
    let db = Db.memory()?
    let _ = db.exec(world_script)?
    db
}

fn made() -> App {
    App { db: match world() { .Ok(db) -> db, .Err(_) -> null }, seed: Cell.new(42) }
}

fn json(value: Json) -> Response {
    Response {
        headers: [Header { name: "content-type", value: "application/json" }],
        body: to_text(value).bytes(),
    }
}

fn world_row(db: Db, id: int) -> Result<Json, SqlError> {
    let n = (db.scalar(sql("select randomNumber from world where id = ?", [SqlValue.Int(id)]))?)
        .int()?
    Json.Obj([field("id", Json.Int(id)), field("randomNumber", Json.Int(n))])
}

fn queried(app: App) -> Response {
    let db? = app.db else { return status(500) }
    match world_row(db, app.next_id()) { .Ok(row) -> json(row), .Err(_) -> status(500) }
}

fn answered(app: App, q: Request<Unrouted>) -> Response {
    match q.path()?.text() ?? "" {
        "/plaintext" -> text(200, "Hello, World!"),
        "/json" -> json(Json.Obj([field("message", Json.Str("Hello, World!"))])),
        "/db" -> queried(app),
        _ -> status(404),
    }
}

fn serving() -> Result<int, NetError> {
    let l = listen("127.0.0.1", parse_int(env_or("PORT", "18080")) ?? 18080)?
    let s = served(l, made, limits(), Timing { requests: 1000000000 }) { app, q -> answered(app, q) }
    s.run(cores: parse_int(env_or("CORES", "1")) ?? 1)
}

match serving() { .Ok(n) -> "${n}", .Err(e) -> "failed: ${e.describe().message}" }
