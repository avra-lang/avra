//! probe: where a UI paint spends its work. A tree is built directly
//! as `Node` data — no component layer — so `frame`'s walk and
//! serialize are measured against the mere construction of the same
//! tree and against `plan` alone.
use @std.time.{now_ns}
use @std.ui.realize.dom.frame.{Live, frame, live}
use @std.ui.realize.render.{Attribute, Node, Prim}
use @std.ui.realize.update.{plan}
use @std.ui.style.box.{Box}
use @std.ui.style.theme.{default_theme}

/// a leaf carrying one word.
fn leaf(i: int) -> Node {
    Node { prim: Prim.Text, attrs: [Attribute.Text("n${i}")], box: Box {}, children: [] }
}

/// a column of `width` leaves — the tree a paint walks.
fn branch(width: int) -> Node {
    Node { prim: Prim.Column, attrs: [], box: Box {}, children: [leaf(i) for i in 0..width] }
}

once fn painted() -> Live { live() }

let a = frame(branch(40))
let b = frame(branch(40))
println("same tree, same bytes: ${a == b} bytes ${a.length}")

let node = branch(40)
println("ops: ${plan(node).length} frame bytes: ${frame(node).length}")

let runs = 200
let t0 = now_ns()
mut acc = 0
// LICENSED loops.push_loop: a timed loop counts, it does not build a list
for i in 0..runs { acc = acc + plan(node).length }
let t1 = now_ns()
println("plan: ${(t1 - t0) / runs} ns/run")

let t2 = now_ns()
// LICENSED loops.push_loop: a timed loop counts, it does not build a list
for i in 0..runs { acc = acc + frame(node).length }
let t3 = now_ns()
println("frame: ${(t3 - t2) / runs} ns/run")

let t4 = now_ns()
// LICENSED loops.push_loop: a timed loop counts, it does not build a list
for i in 0..runs { acc = acc + painted().diff(node, default_theme).length }
let t5 = now_ns()
println("diff: ${(t5 - t4) / runs} ns/run")

let t6 = now_ns()
// LICENSED loops.push_loop: a timed loop counts, it does not build a list
for i in 0..runs { acc = acc + branch(40).children.length }
let t7 = now_ns()
println("construct: ${(t7 - t6) / runs} ns/run (${acc})")

"done"
