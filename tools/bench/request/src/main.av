//! A keep-alive request served in-process, no socket: the bytes a read
//! brings, framed, the handler called, the response written as bytes —
//! the user-space work a connection does per request, alone.
use @std.http.frame.{framed, limits}
use @std.http.http.{Request, text, wire, as_sent}
use @std.time.{now_ns}

fn served(raw: Bytes) -> int {
    match framed(raw, 0, 0, limits()) {
        .Complete(head) -> {
            let q = Request { raw: raw, head: head, body: "".bytes(), peer: "127.0.0.1:1" }
            let r = as_sent(text(200, "hello"))
            let out = "".bytes().concat(wire(r, head.keep_alive, head.minor))
            let rest = raw.slice(head.end, raw.length)
            out.length + rest.length + q.body.length
        },
        .Partial or .Refused(_) -> 0,
    }
}

let raw = "GET / HTTP/1.1\r\nHost: bench\r\nUser-Agent: wrk\r\nAccept: */*\r\n\r\n".bytes()
let n = 5000000
let t0 = now_ns()
mut total = 0
for i in 0..n { total = total + served("".bytes().concat(raw)) }
"${n} requests, ${(now_ns() - t0) / n} ns each (${total / n} bytes out)"
