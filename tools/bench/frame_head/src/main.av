use @std.http.frame.{framed, limits, Framed}
extern fn avra_now_ns() -> int
let head = "GET /ideas/42?x=1 HTTP/1.1\r\nHost: example.com\r\nAccept: */*\r\nUser-Agent: bench/1\r\nConnection: keep-alive\r\n\r\n".bytes()
let lim = limits()
let t0 = avra_now_ns()
mut ok = 0
for i in 0..2000000 { if framed(head, 0, 0, lim) is .Complete { ok = ok + 1 } }
let ns = (avra_now_ns() - t0) / 2000000
"${ok} heads, ${ns} ns each"
