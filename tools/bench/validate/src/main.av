//! WHAT VALIDATION COSTS BESIDE PARSING. §11's Signup, read from
//! `payloads/` (the files the Rust and C references read), two hundred
//! thousand times each way: `@std/json`'s parse alone, parse into a
//! `Value`, `Signup.from_json` straight from the text with every rule,
//! and the same over the payload that breaks eight rules — the refusal
//! path, which builds every issue — then both again the tree's way,
//! parsed into a `Value` and decoded from it. Each line is nanoseconds
//! per payload; `run.sh` interleaves the three and takes medians.
use @std.meta.{derive}
use @std.time.{now_ns}
use @std.io.{read_text, env}
use @std.text.{admits}
use @std.json.{parse}
use @std.validate.{
    Decode,
    Issue,
    Value,
    email,
    range,
    length,
    matches,
    one_of,
    pattern,
    from_json,
    issue,
}

/// Lowercase letters, digits and inner hyphens — a class table, as the
/// Rust side's `bytes().all(…)`.
fn slug(s: string) -> bool {
    !s.starts_with("-") && !s.ends_with("-") && s.bytes().run(0, slug_char) == s.length
}

const slug_char: Bytes = admits((c) -> c >= 97 && c <= 122 || c >= 48 && c <= 57 || c == 45)

@derive(Decode)
@length(min: 3, max: 32)
@pattern(slug, "slug")
type Username = string

/// A cross-field rule: a plain fn over the whole record, run once
/// every field has passed.
fn adult_for_pro(s: Signup) -> Result<Signup, Issue> {
    if s.plan == "pro" && s.age < 18 { fail issue("plan", "pro needs an adult") }
    s
}

@derive(Decode)
@one_of(["music", "maths", "code"])
type Interest = string

@derive(Decode)
@adult_for_pro
type Signup = {
    @email email: string,
    @range(13, 130) age: int,
    username: Username,
    @secret @length(min: 12) password: string,
    @secret @matches(password, "password") confirm: string,
    @one_of(["free", "pro"]) plan: string = "free",
    interests: List<Interest> = [],
    referrer: Username? = null,
}

fn parse_only(text: string, n: int) -> int {
    mut ok = 0
    for _i in 0..n { if parse(text) is .Ok { ok = ok + 1 } }
    ok
}

fn to_value(text: string, n: int) -> int {
    mut ok = 0
    for _i in 0..n { if from_json(text) is .Ok { ok = ok + 1 } }
    ok
}

fn direct(text: string, n: int) -> int {
    mut ok = 0
    for _i in 0..n { if Signup.from_json(text) is .Ok { ok = ok + 1 } }
    ok
}

fn full(text: string, n: int) -> int {
    mut ok = 0
    for _i in 0..n {
        let v = from_json(text) catch Value.Null
        if Signup.decode(v) is .Ok { ok = ok + 1 }
    }
    ok
}

fn timed(label: string, n: int, run: fn(int) -> int) -> int {
    let _warm = run(n / 10)
    let t0 = now_ns()
    let r = run(n)
    println("${label}: ${(now_ns() - t0) / n} ns/payload")
    r
}

let dir = env("AVRA_BENCH_PAYLOADS") ?? "tools/bench/validate/payloads"
let good = read_text("${dir}/valid.json") catch ""
let bad = read_text("${dir}/refused.json") catch ""
let r1 = timed("parse only (valid)", 200000, (n) -> parse_only(good, n))
let r2 = timed("to Value (valid)", 200000, (n) -> to_value(good, n))
let r3 = timed("decode + rules (valid)", 200000, (n) -> direct(good, n))
let r4 = timed("decode + rules (refused, every rule)", 200000, (n) -> direct(bad, n))
let r5 = timed("tree: Value + decode + rules (valid)", 200000, (n) -> full(good, n))
let r6 = timed("tree: Value + decode + rules (refused)", 200000, (n) -> full(bad, n))
"${r1 + r2 + r3 + r4 + r5 + r6}"
