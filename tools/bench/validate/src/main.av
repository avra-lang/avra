//! WHAT VALIDATION COSTS BESIDE PARSING. One Signup payload, read a
//! hundred thousand times four ways: `@std/json`'s parse alone, parse
//! into a `Value`, parse and decode through `@derive(Decode)` with
//! every rule, and the same over a payload that breaks six rules — the
//! refusal path, which builds every issue. Each line is nanoseconds
//! per payload.
use @std.meta.{derive}
use @std.time.{now_ns}
use @std.json.{parse}
use @std.validate.{
    Decode,
    Issue,
    Value,
    email,
    range,
    length,
    matches,
    one_of,
    pattern,
    from_json,
    issue,
}

/// Lowercase letters, digits and inner hyphens.
fn slug(s: string) -> bool {
    !s.starts_with("-") &&
        !s.ends_with("-") &&
        [s.char_code(i) for i in 0..s.length].all(slug_char(it))
}

fn slug_char(c: int) -> bool { c >= 97 && c <= 122 || c >= 48 && c <= 57 || c == 45 }

@derive(Decode)
@length(min: 3, max: 32)
@pattern(slug, "slug")
type Username = string

/// A cross-field rule: a plain fn over the whole record, run once
/// every field has passed.
fn adult_for_pro(s: Signup) -> Result<Signup, Issue> {
    if s.plan == "pro" && s.age < 18 { fail issue("plan", "pro needs an adult") }
    s
}

@derive(Decode)
@adult_for_pro
type Signup = {
    @email email: string,
    @range(13, 130) age: int,
    username: Username,
    @secret @length(min: 12) password: string,
    @secret @matches(password, "password") confirm: string,
    @one_of(["free", "pro"]) plan: string = "free",
}

fn parse_only(text: string, n: int) -> int {
    mut ok = 0
    for _i in 0..n { if parse(text) is .Ok { ok = ok + 1 } }
    ok
}

fn to_value(text: string, n: int) -> int {
    mut ok = 0
    for _i in 0..n { if from_json(text) is .Ok { ok = ok + 1 } }
    ok
}

fn full(text: string, n: int) -> int {
    mut ok = 0
    for _i in 0..n {
        let v = from_json(text) catch Value.Null
        if Signup.decode(v) is .Ok { ok = ok + 1 }
    }
    ok
}

fn timed(label: string, t0: int, t1: int, n: int) {
    println("${label}: ${(t1 - t0) / n} ns/payload")
}

let good = "{\"email\": \"ada@lovelace.dev\", \"age\": 36, \"username\": \"ada-l\", \"password\": \"correct horse battery\", \"confirm\": \"correct horse battery\", \"plan\": \"pro\"}"
let bad = "{\"email\": \"ada@lovelace\", \"age\": 9, \"username\": \"Ada!\", \"password\": \"correct horse\", \"confirm\": \"correct house\", \"plan\": \"prp\", \"admin\": true}"
let n = 100000
let a = now_ns()
let r1 = parse_only(good, n)
let b = now_ns()
let r2 = to_value(good, n)
let c = now_ns()
let r3 = full(good, n)
let e = now_ns()
let r4 = full(bad, n)
let f = now_ns()
timed("std-json parse           (valid)   ", a, b, n)
timed("from_json -> Value       (valid)   ", b, c, n)
timed("from_json + decode       (valid)   ", c, e, n)
timed("from_json + decode       (6 issues)", e, f, n)
"${r1 + r2 + r3 + r4}"
