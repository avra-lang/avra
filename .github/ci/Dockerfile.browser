# The browser leg's machine: the checks' machine (Dockerfile, avra-ci:llvm22) and the host libraries of
# Playwright's WebKit (packages-browser.txt) with gdb, installed when the image is built, never at run
# time, where a mirror mid-update fails a job. The list's digest is stamped at /etc/avra-browser-libs,
# which install_browser_libs.sh reads to install nothing.
FROM ghcr.io/avra-lang/avra-ci:llvm22
COPY packages-browser.txt install_browser_libs.sh /tmp/browser/
RUN sh /tmp/browser/install_browser_libs.sh gdb \
 && grep -v '^#' /tmp/browser/packages-browser.txt | sha256sum | cut -c1-64 > /etc/avra-browser-libs \
 && rm -rf /var/lib/apt/lists/* /tmp/browser
