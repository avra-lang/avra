type Row = { id: int, name: string }
fn twice(x: int) -> int { x * 2 }
fn add(x: int, y: int) -> int { x + y }
fn main() {
    let rows = table<Row> {
        id | name
        1  | "a"
        2  | "b"
    }
    let n = ~5
    let m = 3 |> twice |> add(4)
    println("${rows.length} ${n} ${m} ${rows[1].name}")
}
