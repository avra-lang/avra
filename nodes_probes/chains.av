type P = { n: int }
impl P {
    fn twice() -> int { self.n * 2 }
}
fn get(k: int) -> P? {
    if k > 0 { P { n: k } } else { null }
}
fn apply(f: fn(int) -> int, x: int) -> int { f(x) }
let a = get(3)?.twice() ?? 0
let b = get(0)?.twice() ?? 7
let g: (fn(int) -> int)? = (x: int) -> x + 1
let c = g?.(4) ?? 0
"${a} ${b} ${c}"
