// proves: structs — declaration, a literal built in a fn and at the
// top level, field reads through arithmetic and interpolation, a
// struct crossing a fn boundary
type Point = { x: int, y: int }

fn shift(p: Point, dx: int) -> int {
    p.x + dx
}

fn origin_ish(n: int) -> Point {
    Point { x: n, y: 0 }
}

let p = Point { y: 4, x: 3 }
let q = origin_ish(7)
"at ${p.x},${p.y} shifted ${shift(p, 10)} q ${q.x},${q.y}"
