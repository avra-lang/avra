// proves: octets as a value — the empty case first, equality over
// every byte (a NUL included), the two crossings, and the scans.
let none = "".bytes()
let nul = [104, 0, 105].bytes()!
let hi = "hi".bytes()
let text = [104, 105].bytes()!
let bad = [256].bytes()
let joined = hi.concat(nul)
let tail = joined.slice(2, 5)
"${none.length} ${none.is_empty()} ${[].bytes()!.length} ${nul.length} ${nul == [104, 0, 105].bytes()!} ${nul != hi} ${hi == text} ${bad == null} ${joined.length} ${tail == nul} ${joined.index_of([0].bytes()!, 0)} ${joined.index_of(hi, 1)} ${joined.index_of(none, 5)} ${nul.text()!.length} ${text.text()!} ${[255].bytes()!.text() == null} ${joined.at(3)}"
