fn captured() -> Bytes {
    let packet = [47, 0, 128, 255, 47].bytes()!
    packet.slice(1, 4)!
}

let b = captured()
let same = [0, 128, 255].bytes()!
let prefix = [0].bytes()!
let empty = b.slice(2, 2)!
let invalid = b.slice(0, 4)
let bad_byte = [256].bytes()
let nested = b.slice(1, 3)!.slice(1, 2)!
let copied = nested.copy()
let joined = "hi".bytes().concat([0, 33].bytes()!)
"${b.length} ${b.at(0)} ${b.at(1)} ${b.at(2)} ${b == same} ${b != prefix} ${empty.is_empty()} ${invalid == null} ${bad_byte == null} ${copied.at(0)} ${joined.length}"
