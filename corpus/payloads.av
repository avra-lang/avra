// proves: enum variants that CARRY a value — construction with an
// argument, unit and carrying variants in one enum, matching over
// both, and a payload crossing a fn boundary
enum Shape {
    circle(int)
    square(int)
    point
}

fn kind(s: Shape) -> int {
    match s {
        .circle -> 1
        .square -> 2
        .point -> 0
    }
}

let c = Shape.circle(5)
let q = Shape.square(3)
"kinds ${kind(c)} ${kind(q)} ${kind(Shape.point)}"
