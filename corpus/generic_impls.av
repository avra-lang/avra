// A generic type's impl: one body per instantiation, natively.
type Box<T> = { v: T }
impl Box<T> {
    fn get(self) -> T { self.v }
    fn with(self, x: T) -> Box<T> { Box { v: x } }
    fn twice(self) -> T { self.with(self.get()).get() }
}
type Arena<N> = { nodes: List<N> }
impl Arena<N> {
    fn add(self, n: N) -> int {
        mut nodes = self.nodes
        nodes.push(n)
        nodes.length - 1
    }
    fn count(self) -> int { self.nodes.length }
    fn at(self, i: int) -> N { self.nodes[i] }
}
let ints: Arena<int> = Arena { nodes: [] }
let words: Arena<string> = Arena { nodes: ["a"] }
let first = ints.add(7)
let second = ints.add(9)
"${Box { v: 4 }.get() + 1} ${Box { v: "q" }.with("r").twice()} ${first} ${second} ${ints.count()} ${ints.at(1)} ${words.add("b")} ${words.at(1)}"
