// proves: rung 13 L1 — closures & fn values. Lambdas with by-value
// captures (escaping included — the box outlives its frame),
// named fns as values, indirect calls through fn-typed params and
// bindings, fn types unifying structurally through generics, the
// capability-record pattern (fn-typed struct fields called through
// the dot), and managed captures churned under ownership.
type Ops = { scale: fn(int) -> int, describe: fn(int) -> string }
type U = { name: string }

fn run(ops: Ops, v: int) -> string {
    ops.describe(ops.scale(v))
}

fn make_adder(n: int) -> fn(int) -> int {
    (x: int) -> x + n
}

fn apply<T>(f: fn(T) -> T, v: T) -> T {
    f(v)
}

fn double(x: int) -> int {
    x * 2
}

fn tagger(u: U) -> fn(int) -> string {
    (n: int) -> "${u.name}#${n}"
}

let factor = 3
let scaler: fn(int) -> int = (x: int) -> x * factor
let plain: fn(int) -> string = (x: int) -> "got ${x}"
let ops = Ops { scale: scaler, describe: plain }
let add5 = make_adder(5)
mut t = 0
mut i = 0
while i < 50 {
    let step = make_adder(i)
    t = t + step(1)
    i = i + 1
}
mut last = ""
mut j = 0
while j < 100 {
    let tag = tagger(U { name: "u${j}" })
    last = tag(j)
    j = j + 1
}
"${run(ops, 7)} a ${add5(2)} g ${apply(add5, 30)} n ${apply(double, 8)} c ${t} ${last}"
