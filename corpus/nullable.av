// proves: nullability — `T?` opts in to absence, `null` inhabits it,
// a guarantee WIDENS into it at a boundary, and `??` answers it with
// the right side evaluated only when the left is absent
fn halve(n: int) -> int? {
    if n % 2 == 0 { n / 2 } else { null }
}

fn describe(v: int?) -> int {
    v ?? 0
}

fn boom(n: int) -> int {
    n / 0
}

let even = describe(halve(84))
let odd = describe(halve(7))
let widened = describe(9)
let lazy = halve(10) ?? boom(1)
"even ${even} odd ${odd} widened ${widened} lazy ${lazy}"
