//! EITHER BOX AT EITHER ROW, which is one law read both ways. A row's
//! seat kind is `Ptr`, which a string and a `Bytes` both fill —
//! natively one headered box, read the same way — so a row that READS
//! OCTETS reads either, and only a row that ANSWERS TEXT owes a
//! decode. The length, the byte and the validator answer for a string
//! at a byte row and for octets that are not UTF-8 at a text row; the
//! trim next door still refuses those octets by name.
extern fn avra_bytes_len(s: string) -> int
extern fn avra_bytes_at(s: string, i: int) -> int
extern fn avra_utf8_bad_at(s: string) -> int
extern fn avra_str_len(b: Bytes) -> int
extern fn avra_str_char_code(b: Bytes, i: int) -> int
extern fn avra_bytes_of_str(b: Bytes) -> Bytes

fn wild() -> Bytes { [255, 254].bytes()! }

"${avra_bytes_len("hi")} ${avra_bytes_at("hi", 1)} ${avra_utf8_bad_at("hi")} ${avra_str_len(wild())} ${avra_str_char_code(wild(), 0)} ${avra_bytes_of_str(wild()).at(1)}"
