// proves: maps — string-keyed, insertion-ordered; `get` answers
// absence, `set` is the place law on a method (copy-on-write keeps
// every snapshot), `{}` is adopted like `[]`, and managed values
// churn without a leak the differential can see.
type Reg = { ids: Map<string, int>, names: List<string> }
mut m: Map<string, int> = {}
m.set("a", 1)
m.set("b", 2)
m.set("a", 10)
let snap = m
m.set("c", 3)
let lit = { "x": 5, "y": 6 }
mut words: Map<string, string> = { "hi": "there" }
words.set("bye", "now")
mut r = Reg { ids: {}, names: [] }
r.ids.set("k", 42)
r.ids.set("k", 43)
mut i = 0
while i < 500 {
    words.set("w${i}", "v${i}")
    i = i + 1
}
let a = m.get("a") ?? 0
let zz = m.get("zz") ?? 0 - 1
let y = lit.get("y") ?? 0
let bye = words.get("bye") ?? "-"
let k = r.ids.get("k") ?? 0
let last = words.get("w499") ?? "-"
"${a} ${zz} ${m.length} ${snap.length} ${y} ${lit.length} ${bye} ${words.length} ${k} ${r.ids.length} ${last}"
