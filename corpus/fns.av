// proves: recursion, string-returning branches, and the callee-cleans ABI, natively
fn fib(n: int) -> int { if n < 2 { n } else { fib(n - 1) + fib(n - 2) } }
fn tag(n: int) -> string { if n < 50 { "small" } else { "big" } }
fn shout(s: string) -> string { if s == "big" { "BIG!" } else { s } }
shout(tag(fib(10)))