// proves: enums — declaration, construction, total match (in a fn
// and inline), a variant crossing a fn boundary, match feeding
// arithmetic, and PAYLOADS: a carrying variant built, passed, and
// unpacked by a pattern bind that lives for one arm
enum Suit {
    clubs
    hearts
    spades
}

enum Roll {
    fixed(int)
    doubled(int)
    blank
}

fn rank(s: Suit) -> int {
    match s {
        .clubs -> 1
        .hearts -> 2
        .spades -> 3
    }
}

fn pick(high: bool) -> Suit {
    if high { Suit.spades } else { Suit.clubs }
}

fn score(r: Roll) -> int {
    match r {
        .fixed(n) -> n
        .doubled(n) -> n + n
        .blank -> 0
    }
}

let h = Suit.hearts
let total = rank(h) + rank(pick(true))
let name = match h {
    .clubs -> "clubs"
    .hearts -> "hearts"
    .spades -> "spades"
}
let n = 100
let rolled = score(Roll.doubled(rank(h))) + score(Roll.fixed(n)) + score(Roll.blank)
"${name} total ${total} low ${rank(pick(false))} rolled ${rolled} n ${n}"
