// proves: enums — declaration, construction, total match (in a fn
// and inline), a variant crossing a fn boundary, and match feeding
// arithmetic
enum Suit {
    clubs
    hearts
    spades
}

fn rank(s: Suit) -> int {
    match s {
        .clubs -> 1
        .hearts -> 2
        .spades -> 3
    }
}

fn pick(high: bool) -> Suit {
    if high { Suit.spades } else { Suit.clubs }
}

let h = Suit.hearts
let total = rank(h) + rank(pick(true))
let name = match h {
    .clubs -> "clubs"
    .hearts -> "hearts"
    .spades -> "spades"
}
"${name} total ${total} low ${rank(pick(false))}"
