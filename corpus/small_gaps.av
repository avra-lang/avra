// proves: an empty record, a member after `!`, unary minus, a void fn
// and a void method, and `is` — natively
type Nothing = { }
type Box = { v: int }
enum Shape {
    Dot
    Line(int)
}
fn maybe(on: bool) -> Box? {
    if on { Box { v: 4 } } else { null }
}
fn poke(n: int) {
    let m = n * 2
}
impl Box {
    fn touch(self) {
        let m = self.v
    }
}
fn measure(s: Shape) -> int {
    if s is .Line { 10 } else { 1 }
}
let e = Nothing { }
let b = Box { v: 3 }
poke(1)
b.touch()
maybe(true)!.v + -1 + measure(Shape.Line(2)) + measure(Shape.Dot)
