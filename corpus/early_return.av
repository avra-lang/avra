// proves: `return` — the enclosing fn answers NOW, from any depth,
// with every open scope's debts settled at the site (the evaluator
// has no refcounts, so eval == native on the owned-string search IS
// the proof). The elseless statement-`if` is the guard idiom's home.
fn find_square(limit: int, want: int) -> int {
    mut i = 0
    while i < limit {
        if i * i == want {
            return i
        }
        i = i + 1
    }
    0 - 1
}

fn guarded(n: int) -> int {
    if n < 0 {
        return 0
    }
    n * 2
}

fn maybe(n: int) -> int? {
    if n < 0 {
        return null
    }
    n
}

fn seek(n: int) -> string? {
    mut i = 0
    while i < n {
        let prize = "candidate ${i}"
        if i * 3 == n {
            return prize
        }
        i = i + 1
    }
    null
}

mut total = 0
mut k = 0
while k < 60 {
    total = total + (seek(k) ?? "-").length
    k = k + 1
}
"found ${find_square(100, 49)} missed ${find_square(3, 49)} g ${guarded(0 - 5)} g2 ${guarded(21)} m ${maybe(0 - 1) ?? 0 - 9} m2 ${maybe(6) ?? 0 - 9} churn ${total}"
