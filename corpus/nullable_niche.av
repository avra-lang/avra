// proves: the NICHE — a pointer-shaped nullable IS its value, the
// null pointer is its absence, so `User?`, `string?` and `List<int>?`
// cross fn boundaries and answer through `??`, `!` and `match` with
// no box built anywhere. The spec's own headline example, running.
type User = { age: int }

fn find_user(id: int) -> User? {
    if id == 7 { User { age: 30 } } else { null }
}

fn greeting(b: bool) -> string? {
    if b { "hello" } else { null }
}

fn maybe_list(b: bool) -> List<int>? {
    if b { [1, 2, 3] } else { null }
}

fn hand_back(s: string?) -> string? { s }

let found = find_user(7)!
let missed = match find_user(3) {
    u? -> u.age
    null -> 0 - 1
}
let word = greeting(true) ?? "empty"
let hollow = greeting(false) ?? "empty"
let full = (maybe_list(true) ?? [9]).length
let fallback = (maybe_list(false) ?? [9]).length
let echoed = hand_back("kept") ?? "lost"
"found ${found.age} missed ${missed} word ${word} hollow ${hollow} full ${full} fallback ${fallback} echoed ${echoed}"
