use util.{twice, ident, Pair, Box, Shape, area}
use solo.{only}

fn peek(b: Box<int>) -> int {
    b.v
}

let f = twice
let p = Pair { a: 1, b: 2 }
let s = Shape.Line(5)
let words = ident("across")
twice(21) + ident(3) + f(4) + p.b + helper(100) + only(1) + peek(Box { v: 7 }) + area(s) + words.length
