// proves: `const` — a value the COMPILER settles, so a use IS the
// value: no slot, no load, and a fn body reads one wherever the
// module does (a run-time `let` of the top level it could not).
// The declaration itself emits nothing at all.
const GREETING = "hello"
const ANSWER: int = 42
const READY = true

fn shout(name: string) -> string {
    "${GREETING}, ${name}"
}

fn doubled() -> int {
    ANSWER + ANSWER
}

fn ready_word() -> string {
    if READY { "yes" } else { "no" }
}

"${shout("world")} ${doubled()} ${ready_word()} ${ANSWER}"
