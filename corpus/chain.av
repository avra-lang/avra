// proves: `?.` — the spec's optional chain. The member of what a
// nullable CARRIES, nullable again; an absent subject short-circuits;
// `??` answers the chain and `!` insists on it. Fields and `length`
// both reach through, on the niche's bare pointer.
type User = { age: int }

fn find_user(id: int) -> User? {
    if id == 7 { User { age: 30 } } else { null }
}

fn greeting(b: bool) -> string? {
    if b { "hello" } else { null }
}

fn maybe_list(b: bool) -> List<int>? {
    if b { [1, 2, 3] } else { null }
}

let hit = find_user(7)?.age ?? 0 - 1
let miss = find_user(3)?.age ?? 0 - 1
let word = greeting(true)?.length ?? 0 - 1
let hollow = greeting(false)?.length ?? 0 - 1
let counted = maybe_list(true)?.length ?? 0 - 1
let sure = find_user(7)?.age!
"hit ${hit} miss ${miss} word ${word} hollow ${hollow} counted ${counted} sure ${sure}"
