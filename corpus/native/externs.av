// The host seam, natively: externs declared by their bare symbol,
// called through the runtime's own bodies.
extern fn avra_now_ns() -> int
extern fn avra_selfhost_file_exists(path: string) -> int
extern fn avra_host_is_dir(path: string) -> int
extern fn println(s: string)
extern fn avra_host_env(name: string) -> string
extern fn avra_selfhost_argc() -> int
extern fn avra_selfhost_get_arg_cstr(i: int) -> string
println("from the host")
// the host's own words — argv and the environment — are immortal
// text the program may hold, compare and pass but never owns
let env = avra_host_env("PATH")
let missing = avra_host_env("AVRA_NO_SUCH_VARIABLE_")
let arg0 = avra_selfhost_get_arg_cstr(0)
"${avra_now_ns() > 0} ${avra_selfhost_file_exists("/definitely/not/here")} ${avra_host_is_dir("corpus")} ${avra_selfhost_file_exists("corpus/native/externs.av")} ${env.length > 0} ${missing.length} ${avra_selfhost_argc() >= 1} ${arg0.length > 0} ${arg0 == avra_selfhost_get_arg_cstr(0)}"
