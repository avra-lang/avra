// The host seam, natively: externs declared by their bare symbol,
// called through the runtime's own bodies. THE PROCESS HALF LIVES IN
// corpus/proc-seam NOW — it moved to @std/process's own C, which a
// loose file cannot link, and it is proved there on BOTH engines.
extern fn avra_now_ns() -> int
extern fn avra_selfhost_file_exists(path: string) -> int
extern fn avra_host_is_dir(path: string) -> int
extern fn println(s: string)
extern fn avra_host_env(name: string) -> string
extern fn avra_selfhost_argc() -> int
extern fn avra_selfhost_get_arg_cstr(i: int) -> string
extern fn avra_ptr_at(address: int) -> ptr?

/// An address as a pointer, told apart by its NICHE alone — the one
/// thing observable about a `ptr` is whether it is null, which is
/// exactly what a C sentinel of 0 means.
fn minted(p: ptr?) -> string {
    if p == null {
        "null"
    } else {
        "some"
    }
}

println("from the host")
// the host's own words — argv and the environment — are immortal
// text the program may hold, compare and pass but never owns
let env = avra_host_env("PATH")
let missing = avra_host_env("AVRA_NO_SUCH_VARIABLE_")
let arg0 = avra_selfhost_get_arg_cstr(0)
// AN ADDRESS BECOMES A POINTER, and only through this one named
// door: no cast, no widening seat. Zero IS the null pointer, so the
// niche carries the C sentinel with no extra word — SQLITE_STATIC is
// 0 and SQLITE_TRANSIENT is -1, and they differ by presence alone.
let at_zero = minted(avra_ptr_at(0))
let at_one = minted(avra_ptr_at(1))
let at_transient = minted(avra_ptr_at(0 - 1))
"${avra_now_ns() > 0} ${avra_selfhost_file_exists("/definitely/not/here")} ${avra_host_is_dir("corpus")} ${avra_selfhost_file_exists("corpus/native/externs.av")} ${env.length > 0} ${missing.length} ${avra_selfhost_argc() >= 1} ${arg0.length > 0} ${arg0 == avra_selfhost_get_arg_cstr(0)} ${at_zero} ${at_one} ${at_transient}"
