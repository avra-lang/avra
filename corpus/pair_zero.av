// proves: the PAIR — a scalar nullable is {present, value} in
// registers, no box, and a PRESENT ZERO is not absence: the flag
// carries the answer the payload cannot. false is not absent either.
fn z(b: bool) -> int? {
    if b { 0 } else { null }
}

fn no(b: bool) -> bool? {
    if b { false } else { null }
}

let present_zero = z(true) ?? 5
let absent = z(false) ?? 7
let held_false = if no(true) ?? true { 1 } else { 0 }
let missing = if no(false) ?? true { 1 } else { 0 }
let asked = match z(true) {
    v? -> 100 + v
    null -> 0 - 1
}
"zero ${present_zero} absent ${absent} false ${held_false} missing ${missing} asked ${asked}"
