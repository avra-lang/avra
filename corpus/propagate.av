// proves: `?` — absence passed to the caller. A present value
// unwraps in place; an absent one makes the enclosing fn answer
// `null` right there, debts settled at the exit (the owned string
// churns to prove it). Rides both reprs: the niche's pointer and
// the scalar pair.
type User = { age: int }

fn find_user(id: int) -> User? {
    if id == 7 { User { age: 36 } } else { null }
}

fn age_of(id: int) -> int? {
    let u = find_user(id)?
    u.age
}

fn greeting(b: bool) -> string? {
    if b { "hello" } else { null }
}

fn shouted(b: bool) -> string? {
    let word = greeting(b)?
    "${word}!"
}

fn doubled(v: int?) -> int? {
    v? * 2
}

fn owned_churn(id: int) -> int? {
    let held = "kept ${id}"
    let u = find_user(id)?
    u.age + held.length
}

let hit = age_of(7) ?? 0 - 1
let miss = age_of(3) ?? 0 - 1
let loud = shouted(true) ?? "quiet"
let hush = shouted(false) ?? "quiet"
let twice = doubled(21) ?? 0 - 1
let never = doubled(null) ?? 0 - 1
let kept = owned_churn(7) ?? 0 - 1
let dropped = owned_churn(3) ?? 0 - 1
"hit ${hit} miss ${miss} loud ${loud} hush ${hush} twice ${twice} never ${never} kept ${kept} dropped ${dropped}"
