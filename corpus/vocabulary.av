// The built-in vocabulary, native and evaluated alike: the list
// scans, growth words, edges and copies; the text scans and copies.
mut xs = [3, 1, 2]
let ys = xs.concat([9])
xs.set(0, 7)
let popped = xs.pop()
let words = "a-b-c".split("-")
mut sum = 0
for (i, w) in words.enumerate() {
    sum = sum + i * w.char_code()
}
let lists = "${xs.length} ${xs[0]} ${ys.length} ${ys[3]} ${popped} ${xs.contains(7)} ${xs.index_of(1)} ${xs.is_empty()} ${xs.first() ?? 0} ${ys.last() ?? 0} ${ys.slice(1, 3).length} ${ys.slice(1, 3)[0]}"
let texts = "${words.length} ${words.join("+")} ${sum} ${"hello".substring(1, 3)} ${"hello".contains("ell")} ${"hello".starts_with("he")} ${"hello".ends_with("lo")} ${"hello".index_of("l")} ${"a.b.c".replace(".", "/")} ${" x ".trim()}|${"ab".split("").length}"
"${lists} / ${texts}"
