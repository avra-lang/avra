use @std.relation.{codec}
use @std.meta.{dense}

@dense
type Tid = { index: int }

@codec
type K0 = { a: int, b: string, ids: List<Tid>, c: int? }

@codec
type K1 = { a: int, b: string, ids: List<Tid>, c: int? }

@codec
type K2 = { a: int, b: string, ids: List<Tid>, c: int? }

@codec
type K3 = { a: int, b: string, ids: List<Tid>, c: int? }

@codec
type K4 = { a: int, b: string, ids: List<Tid>, c: int? }

@codec
type K5 = { a: int, b: string, ids: List<Tid>, c: int? }

@codec
type K6 = { a: int, b: string, ids: List<Tid>, c: int? }

@codec
type K7 = { a: int, b: string, ids: List<Tid>, c: int? }

type Tbl<V> = { lo: int, hi: int, cells: List<V>, seed: V }

@codec
type Facts = { c0: Tbl<K0?>, c1: Tbl<K1?>, c2: Tbl<K2?>, c3: Tbl<K3?>, c4: Tbl<K4?>, c5: Tbl<K5?>, c6: Tbl<K6?>, c7: Tbl<K7?> }

