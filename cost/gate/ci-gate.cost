# gate/ci-gate — what the compiler costs, measured by `wisp cost`
# the gate's own wall: the first job's start to the verdict, each rung the train climbs priced at 300 s apart;
# a train whose compiler source moved is `compiler`, any other `plain`

[gate]
clock makespan_compiler 1956000 target 1500000 over avra-lane-r2-gate-speed .112.28
clock makespan_plain 1020000 target 900000 over avra-lane-r2-gate-speed .112.28
