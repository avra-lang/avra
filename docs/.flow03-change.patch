+    }
+    then "the record line's last field is the bit" {
+        let lines = napping().concat(["nap()"])
+        let ws = reach_workspace(lines.concat([""]).join("\n"))
+        let _ = ws.analyze_file(REACH_PATH)
+        ws.record_line(ws.decls.raw_decl(reach_decl(ws, "nap")), 0, false) == line_with(lines, "nap", "1")
+    }
+    then "the bit moves the interface digest, so a caller keyed on it is rebuilt" {
+        let lines = napping().concat(["nap()"])
+        iface_digest([line_with(lines, "nap", "1")]) != iface_digest([line_with(lines, "nap", "0")])
+    }
+}
